{%- assign block_settings = block.settings -%}

{% liquid
  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, section_id: block.id
  endif
%}

{% if block_settings.background_color != blank %}
  {% style %}
    blog-posts-list[section-id="{{ section.id }}"] .blog-post-item {
      --color-background: {{ block_settings.background_color }};
    }
  {% endstyle %}
{% endif %}

<div
  class="blog-post-card{% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="--text-align: {{ block_settings.alignment }}"
>
  {% if article.image %}
    {% content_for 'block', id: 'image', type: '_blog-post-image', article: article %}
  {% endif %}

  <div class="blog-post-card__content">
    <a
      class="blog-post-card__title-link"
      href="{{ article.url }}"
      data-testid="blog-post-link"
    >
      {%- content_for 'block', id: 'heading', type: '_heading', text: article.title -%}
    </a>

    {% content_for 'block',
      id: 'blog-post-details',
      type: '_blog-post-info-text',
      alignment: block_settings.alignment,
      article: article
    %}

    {% content_for 'block', id: 'content', type: '_blog-post-description', article: article, show_read_more: true %}
  </div>
</div>

{% stylesheet %}
  .blog-post-card {
    display: flex;
    flex-direction: column;
    text-align: var(--text-align);
    column-gap: var(--columns-gap);
    height: 100%;
  }

  /* Image: consistent ratio, rounded corners, gentle zoom on hover */
  .blog-post-item .blog-post-card__image-container {
    width: 100%;
    overflow: hidden;
    border-radius: 16px;
  }

  .blog-post-item .blog-post-card__image-container img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .blog-post-card:hover .blog-post-card__image-container img {
    transform: scale(1.04);
  }

  .blog-post-card__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    padding-block-start: 20px;
  }

  .blog-post-card__content a {
    display: block;
    text-wrap: pretty;
    text-decoration: none;
    padding-block-start: 0;
    color: var(--color-foreground);
  }

  a.blog-post-card__title-link {
    color: var(--color-foreground);
    transition: opacity 0.2s ease;
  }

  a.blog-post-card__title-link:hover {
    color: var(--color-foreground);
    opacity: 0.65;
  }

  .blog-post-card__content a:hover {
    color: var(--color-foreground);
  }

  /* Meta line (date / read time) */
  .blog-post-card .blog-post-details {
    padding-block-start: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Excerpt: clamp to 3 lines */
  .blog-post-card__content-text,
  .blog-post-card__content p {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-block: 8px 0;
    line-height: 1.7;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.7));
  }

  /* Hero layout: image left, text right */
  .blog-post-item--horizontal .blog-post-card {
    flex-direction: row;
    align-items: center;
    gap: 48px;

    @media screen and (max-width: 749px) {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
  }

  .blog-post-item--horizontal:has(.blog-post-card__image-container) .blog-post-card > *:first-child {
    flex: 1.35 1 0;
    min-width: 0;
  }

  .blog-post-item--horizontal:has(.blog-post-card__image-container) .blog-post-card > *:last-child {
    flex: 1 1 0;
    min-width: 0;
  }

  .blog-post-item--horizontal .blog-post-card__image-container img {
    aspect-ratio: 16 / 11;
  }

  .blog-post-item--horizontal .blog-post-card__content {
    padding-block-start: 0;
    gap: 10px;
  }

  .blog-post-item--horizontal .blog-post-card__content-text,
  .blog-post-item--horizontal .blog-post-card__content p {
    -webkit-line-clamp: 5;
    font-size: 1.0625rem;
  }

  .blog-post-item--horizontal .blog-post-card__title-link .spacing-style,
  .blog-post-item--horizontal .blog-post-details,
  .blog-post-item--horizontal .blog-post-card__content-text {
    padding-inline-start: 0;
  }

  /* Posts without an image: soft card instead of an outlined box */
  .blog-post-item:not(:has(.blog-post-card__image-container)) .blog-post-card {
    background: rgb(var(--color-foreground-rgb) / 0.04);
    border-radius: 16px;
    padding: 28px;
  }

  .blog-post-item:not(:has(.blog-post-card__image-container)) .blog-post-card__content {
    padding-block-start: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
