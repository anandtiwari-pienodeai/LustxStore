<div
  class="blog-post-content rte"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {{ article.content }}
  </rte-formatter>
</div>

{% stylesheet %}
  .blog-post-content {
    max-width: 720px;
    margin: 0 auto;
    color: var(--color, inherit);
    font-size: 1.125rem;
    line-height: 1.85;
  }

  .blog-post-content > p:first-of-type {
    font-size: 1.3125rem;
    line-height: 1.7;
  }

  .blog-post-content p,
  .blog-post-content ul,
  .blog-post-content ol {
    margin-block: 0 1.4em;
  }

  .blog-post-content h2,
  .blog-post-content h3,
  .blog-post-content h4 {
    margin-block: 2.2em 0.7em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .blog-post-content h2 {
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
  }

  .blog-post-content h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
  }

  .blog-post-content a {
    color: currentcolor;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .blog-post-content a:hover {
    text-decoration-thickness: 2px;
  }

  .blog-post-content img {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .blog-post-content blockquote {
    margin: 2em 0;
    padding: 4px 0 4px 28px;
    border-inline-start: 3px solid currentcolor;
    font-size: 1.375rem;
    line-height: 1.55;
    font-style: italic;
  }

  .blog-post-content blockquote p {
    margin: 0;
  }

  .blog-post-content ul,
  .blog-post-content ol {
    padding-inline-start: 1.4em;
  }

  .blog-post-content li {
    margin-block-end: 0.5em;
  }

  .blog-post-content hr {
    margin-block: 3em;
    border: 0;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
  }

  .blog-post-content table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
  }

  .blog-post-content th,
  .blog-post-content td {
    padding: 12px 16px;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    text-align: start;
  }

  @media screen and (max-width: 749px) {
    .blog-post-content {
      font-size: 1.0625rem;
      line-height: 1.8;
    }

    .blog-post-content > p:first-of-type {
      font-size: 1.1875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ],
  "presets": [
    {
      "name": "t:names.content",
      "category": "t:categories.blog_post"
    }
  ]
}
{% endschema %}
