{% liquid
  assign icon_class = 'feature-card__icon feature-card__icon-' | append: block.id
%}

{% style %}
  .feature-card-{{ block.id }} .feature-card__icon-{{ block.id }} {
    color: {{ block.settings.accent_color }};
  }
  .feature-card-{{ block.id }} .feature-card__number {
    background-color: {{ block.settings.accent_color }};
  }
{% endstyle %}

<div class="feature-card feature-card-{{ block.id }}" {{ block.shopify_attributes }} data-testid="feature-card">
  <div class="feature-card__badge-row">
    <span class="feature-card__number">{{ block.settings.number }}</span>
    {% render 'icon-or-image', icon: block.settings.icon, image_upload: block.settings.image_upload, width: 26, class_name: icon_class %}
  </div>
  <div class="feature-card__heading h5">{{ block.settings.heading }}</div>
  <div class="feature-card__desc paragraph">{{ block.settings.description }}</div>
  {% if block.settings.card_image != blank %}
    {{
      block.settings.card_image
      | image_url: width: 800
      | image_tag: class: 'feature-card__image', widths: '400, 600, 800'
    }}
  {% endif %}
</div>

{% stylesheet %}
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background-color: #ffffff;
    border-radius: 16px;
    padding: 20px 16px;
  }

  .feature-card__badge-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .feature-card__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 0.75rem;
    line-height: 1;
    padding: 4px 9px;
    border-radius: 50px;
  }

  .feature-card__desc {
    font-size: 0.8rem;
  }

  .feature-card__image {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
{% endstylesheet %}

