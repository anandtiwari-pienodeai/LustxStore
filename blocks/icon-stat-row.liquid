{% liquid
  assign icon_class = 'icon-stat-row__icon icon-stat-row__icon-' | append: block.id
%}

{% style %}
  .icon-stat-row-{{ block.id }} {
    gap: {{ block.settings.gap }}px;
  }
  .icon-stat-row-{{ block.id }} .icon-stat-row__icon-{{ block.id }} {
    color: {{ block.settings.accent_color }};
  }
  .icon-stat-row-{{ block.id }} .icon-stat-row__text {
    font-size: {{ block.settings.font_size }};
    {% if block.settings.text_color != blank %}
      color: {{ block.settings.text_color }};
    {% endif %}
  }
{% endstyle %}

<div class="icon-stat-row icon-stat-row-{{ block.id }}" {{ block.shopify_attributes }} data-testid="icon-stat-row">
  {% render 'icon-or-image', icon: block.settings.icon, image_upload: block.settings.image_upload, width: block.settings.icon_width, class_name: icon_class %}
  <div class="icon-stat-row__text paragraph">{{ block.settings.text }}</div>
</div>

{% stylesheet %}
  .icon-stat-row {
    display: flex;
    align-items: flex-start;
  }

{% endstylesheet %}

