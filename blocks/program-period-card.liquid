{% liquid
  assign icon_class = 'program-period-card__icon program-period-card__icon-' | append: block.id
%}

{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% style %}
  .program-period-card-{{ block.id }} {
    background-color: {{ block.settings.card_bg }};
  }
  .program-period-card-{{ block.id }} .program-period-card__badge {
    background-color: {{ block.settings.icon_accent }};
  }
  .program-period-card-{{ block.id }} .program-period-card__icon-{{ block.id }} {
    color: {{ block.settings.icon_accent }};
  }
  .program-period-card-{{ block.id }} .program-period-card__ingredients-label,
  .program-period-card-{{ block.id }} .program-period-card__count {
    color: {{ block.settings.text_accent }};
  }
{% endstyle %}

<div class="program-period-card program-period-card-{{ block.id }}" {{ block.shopify_attributes }} data-testid="program-period-card">
  <span class="program-period-card__badge">{{ block.settings.badge }}</span>

  <div class="program-period-card__header">
    {% render 'icon-or-image', icon: block.settings.icon, image_upload: block.settings.image_upload, width: 30, class_name: icon_class %}
    <div class="program-period-card__title h4">{{ block.settings.title }}</div>
  </div>

  <div class="program-period-card__body paragraph">{{ block.settings.body }}</div>

  <div class="program-period-card__inside">
    <div class="program-period-card__inside-left">
      <div class="program-period-card__ingredients-label">{{ block.settings.ingredients_label }}</div>
      <div class="program-period-card__ingredients">
        {{ children }}
      </div>
    </div>
    <div class="program-period-card__inside-right">
      <div class="program-period-card__count">{{ block.settings.count }}</div>
      <div class="program-period-card__count-label">{{ block.settings.count_label }}</div>
    </div>
  </div>
</div>

{% stylesheet %}
  .program-period-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-radius: 24px;
    padding: 26px 24px;
  }

  .program-period-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    padding: 5px 12px;
    border-radius: 8px;
  }

  .program-period-card__header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .program-period-card__title {
    color: #2a2a2a;
  }

  .program-period-card__body {
    font-size: 0.8125rem;
    color: #5a5a5a;
  }

  .program-period-card__inside {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background-color: rgb(255 255 255 / 0.7);
    border-radius: 14px;
    padding: 14px 16px;
  }

  .program-period-card__inside-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .program-period-card__ingredients-label {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .program-period-card__ingredients {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .program-period-card__inside-right {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }

  .program-period-card__count {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .program-period-card__count-label {
    max-width: 8rem;
    font-size: 0.6875rem;
    line-height: 1.2;
    color: #5a5a5a;
  }
{% endstylesheet %}

