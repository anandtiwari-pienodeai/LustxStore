{%- liquid
  assign notes = section.blocks | where: 'type', 'safety_note'
  assign faqs = section.blocks | where: 'type', 'faq'
-%}

<section
  class="arka-sec arka-info"
  style="--arka-hero-bg: {{ section.settings.bg_color }}; --pbs: {{ section.settings.padding_block_start }}px; --pbe: {{ section.settings.padding_block_end }}px;"
>
  <div class="arka-wrap">
    <div class="arka-info__grid">
      <div class="arka-info__col">
        {%- if section.settings.notes_eyebrow != blank -%}
          <p class="arka-eyebrow">{{ section.settings.notes_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.notes_heading != blank -%}
          <h2 class="arka-info__title">{{ section.settings.notes_heading }}</h2>
        {%- endif -%}
        <div class="arka-notes">
          {%- for block in notes -%}
            <div class="arka-note" {{ block.shopify_attributes }}>
              <div class="arka-note__title">{{ block.settings.title }}</div>
              <div class="arka-note__body">{{ block.settings.body }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="arka-info__col">
        {%- if section.settings.faq_eyebrow != blank -%}
          <p class="arka-eyebrow">{{ section.settings.faq_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.faq_heading != blank -%}
          <h2 class="arka-info__title">{{ section.settings.faq_heading }}</h2>
        {%- endif -%}
        <div class="arka-faqs">
          {%- for block in faqs -%}
            <details class="arka-faq" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="arka-faq__q">
                <span>{{ block.settings.question }}</span>
                <span class="arka-faq__icon" aria-hidden="true"></span>
              </summary>
              <div class="arka-faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .arka-info__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4.5vw, 3.5rem);
  }

  .arka-info__title {
    font-family: var(--arka-font-heading);
    font-size: clamp(22px, 2.6vw, 26px);
    font-weight: 600;
    margin: 0 0 20px;
    color: var(--arka-heading);
  }

  .arka-notes {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .arka-note {
    border-top: 1px solid var(--arka-line);
    padding-top: 14px;
  }

  .arka-note__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--arka-heading);
    margin-bottom: 4px;
  }

  .arka-note__body {
    font-size: 13px;
    color: var(--arka-muted);
    line-height: 1.6;
  }

  .arka-note__body > :first-child { margin-top: 0; }
  .arka-note__body > :last-child { margin-bottom: 0; }

  .arka-faqs {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .arka-faq {
    border: 1px solid var(--arka-line);
    border-radius: 4px;
    overflow: hidden;
  }

  .arka-faq__q {
    width: 100%;
    text-align: left;
    padding: 16px 18px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--arka-heading);
    list-style: none;
  }

  .arka-faq__q::-webkit-details-marker { display: none; }

  .arka-faq__icon {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .arka-faq__icon::before,
  .arka-faq__icon::after {
    content: "";
    position: absolute;
    background: var(--arka-accent);
    inset: 0;
    margin: auto;
  }

  .arka-faq__icon::before { width: 100%; height: 1.5px; }
  .arka-faq__icon::after { width: 1.5px; height: 100%; transition: transform 0.15s ease; }
  .arka-faq[open] .arka-faq__icon::after { transform: scaleY(0); }

  .arka-faq__a {
    padding: 0 18px 16px;
    font-size: 13px;
    color: var(--arka-muted);
    line-height: 1.6;
  }

  .arka-faq__a > :first-child { margin-top: 0; }
  .arka-faq__a > :last-child { margin-bottom: 0; }

  @media (max-width: 899px) {
    .arka-info__grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Arka PDP — Info & FAQ",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "notes_eyebrow", "label": "Left eyebrow", "default": "Good To Know" },
    { "type": "text", "id": "notes_heading", "label": "Left heading", "default": "Ingredients & Safety" },
    { "type": "text", "id": "faq_eyebrow", "label": "Right eyebrow", "default": "Questions" },
    { "type": "text", "id": "faq_heading", "label": "Right heading", "default": "FAQ" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5EEE3" },
    { "type": "range", "id": "padding_block_start", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_block_end", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "safety_note",
      "name": "Safety note",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Who it's for" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Formulated for adult women. Not intended for those who are pregnant or nursing.</p>" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does one box last?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Each box is a complete 45-day supply — one pouch of each formula per day.</p>" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arka PDP — Info & FAQ",
      "blocks": [
        { "type": "safety_note", "settings": { "title": "Who it's for", "body": "<p>Formulated for adult women. Not intended for those who are pregnant or nursing.</p>" } },
        { "type": "safety_note", "settings": { "title": "Sourcing", "body": "<p>Plant-based actives, standardised extracts, third-party tested for purity.</p>" } },
        { "type": "safety_note", "settings": { "title": "Storage", "body": "<p>Store in a cool, dry place away from direct sunlight.</p>" } },
        { "type": "faq", "settings": { "question": "How long does one box last?", "answer": "<p>Each box is a complete 45-day supply — one pouch of each formula per day.</p>", "open_by_default": true } },
        { "type": "faq", "settings": { "question": "Can I take all three pouches together?", "answer": "<p>We recommend spacing them across the day for best absorption, but it is safe to take them together.</p>" } },
        { "type": "faq", "settings": { "question": "Is it safe with other supplements?", "answer": "<p>Generally yes. If you take prescription medication, check with your doctor first.</p>" } },
        { "type": "faq", "settings": { "question": "When will I see results?", "answer": "<p>Most people notice changes within the first full 45-day cycle.</p>" } }
      ]
    }
  ]
}
{% endschema %}
