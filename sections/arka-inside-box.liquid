<section
  class="arka-sec arka-box"
  style="--pbs: {{ section.settings.padding_block_start }}px; --pbe: {{ section.settings.padding_block_end }}px; --arka-hero-bg: {{ section.settings.page_bg }};"
>
  <div class="arka-wrap">
    <div class="arka-box__panel" style="--panel-bg: {{ section.settings.panel_bg }};">
      <div class="arka-box__media">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 40vw, 90vw', widths: '400, 600, 800, 1000, 1200', alt: section.settings.heading | escape }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'arka-box__ph' }}
        {%- endif -%}
      </div>
      <div class="arka-box__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="arka-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="arka-box__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="arka-box__body">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="arka-box__stats">
            {%- for block in section.blocks -%}
              <div class="arka-box__stat" {{ block.shopify_attributes }}>
                <span class="arka-box__stat-value">{{ block.settings.value }}</span>
                <span class="arka-box__stat-label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .arka-box__panel {
    background: var(--panel-bg, var(--arka-panel));
    border-radius: 8px;
    padding: clamp(1.75rem, 4vw, 56px);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 48px);
    align-items: center;
  }

  .arka-box__media {
    border-radius: 6px;
    overflow: hidden;
  }

  .arka-box__media img,
  .arka-box__media svg {
    width: 100%;
    display: block;
  }

  .arka-box__title {
    font-family: var(--arka-font-heading);
    font-size: clamp(22px, 2.8vw, 28px);
    font-weight: 600;
    margin: 0 0 16px;
    color: var(--arka-heading);
  }

  .arka-box__body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--arka-muted);
    margin: 0 0 28px;
  }

  .arka-box__body > :first-child { margin-top: 0; }
  .arka-box__body > :last-child { margin-bottom: 0; }

  .arka-box__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .arka-box__stat-value {
    display: block;
    font-family: var(--arka-font-heading);
    font-size: 22px;
    font-weight: 600;
    color: var(--arka-brand);
  }

  .arka-box__stat-label {
    display: block;
    font-size: 13px;
    color: var(--arka-muted);
    margin-top: 2px;
  }

  @media (max-width: 899px) {
    .arka-box__panel {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 28px;
    }
  }

  @media (max-width: 480px) {
    .arka-box__panel {
      padding: 22px;
    }

    .arka-box__body {
      margin-bottom: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Arka PDP — Inside the box",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside The Box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A 45-Day Foundation, A Lifelong Commitment" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Each box holds 45 daily pouches — one Morning Balance, one Afternoon Glow, and one Evening Restore — organised into a complete daily system so you never have to think about what to take, or when.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color", "id": "page_bg", "label": "Section background", "default": "#F5EEE3" },
    { "type": "color", "id": "panel_bg", "label": "Panel background", "default": "#F3E1DB" },
    { "type": "range", "id": "padding_block_start", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_block_end", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "45 Days" },
        { "type": "text", "id": "label", "label": "Label", "default": "Complete cycle" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Arka PDP — Inside the box",
      "blocks": [
        { "type": "stat", "settings": { "value": "45", "label": "Daily pouches" } },
        { "type": "stat", "settings": { "value": "3", "label": "Targeted formulas" } },
        { "type": "stat", "settings": { "value": "90", "label": "Tablets total" } },
        { "type": "stat", "settings": { "value": "100%", "label": "Vegetarian" } }
      ]
    }
  ]
}
{% endschema %}
