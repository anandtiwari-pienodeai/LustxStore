{%- comment -%}
  BODY अर्क WOMEN — homepage (matches the "Lust Xstore Women Homepage" design).
  The page markup + interactions are loaded from the files below (Settings → Files).
  To update the design, replace ba-home-dc.txt and bump the version in its URL.
{%- endcomment -%}
{%- unless section.settings.show_community and section.settings.show_real_life and section.settings.show_faq and section.settings.show_promise_card -%}
  <style>
    /* Blocks from ba-home-dc.txt hidden from the theme editor */
    {%- unless section.settings.show_community %} #ba-home-mount #community { display: none !important; }{% endunless %}
    {%- unless section.settings.show_real_life %} #ba-home-mount #real-life { display: none !important; }{% endunless %}
    {%- unless section.settings.show_faq %} #ba-home-mount #faq { display: none !important; }{% endunless %}
    {%- comment -%} "Our promise, in short" card: the only 32px-radius dark (#2a1a1f) panel in #promise. The runtime writes normalised inline styles. {%- endcomment -%}
    {%- unless section.settings.show_promise_card %} #ba-home-mount #promise [style*="border-radius: 32px"][style*="rgb(42, 26, 31)"] { display: none !important; }{% endunless %}
  </style>
{%- endunless -%}
<div id="ba-home-mount" class="ba-home" style="min-height:100vh;background:#fdf4ef;"></div>
<script>
  (function () {
    var DC_URL = {{ section.settings.dc_url | default: 'https://cdn.shopify.com/s/files/1/0788/8814/0938/files/ba-home-dc.txt?v=1790428236' | json }};
    var RT_URL = {{ section.settings.runtime_url | default: 'https://cdn.shopify.com/s/files/1/0788/8814/0938/files/ba-dc-runtime.txt?v=1790428137' | json }};
    Promise.all([
      fetch(DC_URL).then(function (r) { return r.text(); }),
      fetch(RT_URL).then(function (r) { return r.text(); })
    ]).then(function (res) {
      var mount = document.getElementById('ba-home-mount');
      mount.innerHTML = res[0];
      relabelHero(mount);
      var s = document.createElement('script');
      s.textContent = res[1];
      document.body.appendChild(s);
      relabelHero(mount);
      setTimeout(function () { mount.style.minHeight = ''; relabelHero(mount); }, 1500);
    }).catch(function (e) { console.error('[BODY ARK home] failed to load', e); });

    // The hero buttons in the design file are plain <button>s with no action.
    // Route them by their label (delegated, so it survives the runtime re-rendering).
    {% liquid
      assign secondary_url = section.settings.secondary_cta_link
      if secondary_url == blank and section.settings.secondary_cta_product != blank
        assign secondary_url = section.settings.secondary_cta_product.url
      endif
      if secondary_url == blank
        assign secondary_url = collections.all.products.first.url | default: '/collections/all'
      endif
    %}
    var SECONDARY_LABEL = {{ section.settings.secondary_cta_label | default: 'Explore the Product' | upcase | json }};
    var HERO_LINKS = {
      'BEGIN YOUR 45-DAY JOURNEY': {{ section.settings.primary_cta_link | default: '/pages/our-program' | json }}
    };
    HERO_LINKS[SECONDARY_LABEL] = {{ secondary_url | json }};

    // Rename the design file's second hero button ("EXPLORE THE PROGRAM").
    function relabelHero(mount) {
      mount.querySelectorAll('button').forEach(function (button) {
        if (button.textContent.trim().toUpperCase() === 'EXPLORE THE PROGRAM') button.textContent = SECONDARY_LABEL;
      });
    }
    document.getElementById('ba-home-mount').addEventListener('click', function (event) {
      var button = event.target.closest('button');
      if (!button) return;
      var url = HERO_LINKS[button.textContent.trim().toUpperCase()];
      if (url) window.location.href = url;
    });
  })();
</script>
{% schema %}
{
  "name": "BODY ARK Women Home",
  "tag": "section",
  "class": "ba-home-section",
  "settings": [
    { "type": "url", "id": "dc_url", "label": "Design source URL (optional override)" },
    { "type": "url", "id": "runtime_url", "label": "Runtime URL (optional override)" },
    { "type": "header", "content": "Sections" },
    { "type": "checkbox", "id": "show_real_life", "label": "Show \"Everyday wellness experience\" section", "default": true },
    { "type": "checkbox", "id": "show_community", "label": "Show \"Discover the community\" section", "default": true },
    { "type": "checkbox", "id": "show_promise_card", "label": "Show built-in \"Our promise, in short\" card", "info": "Off when the separate Promise section is used.", "default": true },
    { "type": "checkbox", "id": "show_faq", "label": "Show built-in FAQ", "info": "Off when the separate FAQ section is used.", "default": true },
    { "type": "header", "content": "Hero buttons" },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "\"Begin your 45-day journey\" link",
      "info": "Defaults to the Our Program page."
    },
    { "type": "text", "id": "secondary_cta_label", "label": "Second button label", "default": "Explore the Product" },
    { "type": "product", "id": "secondary_cta_product", "label": "Second button product", "info": "The button opens this product's page." },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Second button link (optional)",
      "info": "Overrides the product above."
    }
  ],
  "presets": [{ "name": "BODY ARK Women Home" }]
}
{% endschema %}
