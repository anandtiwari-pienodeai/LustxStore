<section class="home-sec home-news" style="--h-sec-bg: {{ section.settings.bg_color }}; --h-pbs: {{ section.settings.padding_block_start }}px; --h-pbe: {{ section.settings.padding_block_end }}px;">
  <div class="home-wrap">
    <div class="home-news__card">
      <div class="home-news__text">
        {%- if section.settings.heading != blank -%}<h3 class="home-news__title">{{ section.settings.heading }}</h3>{%- endif -%}
        {%- if section.settings.subtext != blank -%}<p class="home-news__sub">{{ section.settings.subtext }}</p>{%- endif -%}
      </div>

      {%- form 'customer', class: 'home-news__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="home-news__success">{{ section.settings.success_text }}</p>
        {%- else -%}
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | default: 'Email Address' }}"
            aria-label="Email Address"
            required
            class="home-news__input"
          >
          <button type="submit" class="home-news__btn">{{ section.settings.button_label | default: 'Subscribe →' }}</button>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="home-news__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .home-news__card {
    max-width: 1100px;
    margin: 0 auto;
    background: var(--h-pink-soft);
    border-radius: 20px;
    padding: 32px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .home-news__text { max-width: 420px; }

  .home-news__title {
    font-family: var(--h-font-head);
    font-size: 20px;
    margin: 0 0 8px;
    color: var(--h-green-deep);
  }

  .home-news__sub {
    font-size: 13px;
    color: var(--h-muted-2);
    margin: 0;
  }

  .home-news__form {
    display: flex;
    gap: 10px;
    flex: 1;
    max-width: 420px;
    flex-wrap: wrap;
  }

  .home-news__input {
    flex: 1;
    min-width: 180px;
    border: 1px solid #e6b8c6;
    border-radius: 8px;
    padding: 12px 16px;
    font: inherit;
    font-size: 13px;
    background: #fff;
  }

  .home-news__btn {
    background: var(--h-accent);
    color: #fff;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-family: var(--h-font-body);
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
  }

  .home-news__btn:hover { background: var(--h-accent-dark); }

  .home-news__success { font-size: 13px; color: var(--h-green); font-weight: 600; margin: 0; }
  .home-news__error { flex-basis: 100%; font-size: 12px; color: #b3261e; margin: 4px 0 0; }

  @media (max-width: 860px) {
    .home-news__card { flex-direction: column; align-items: stretch; text-align: left; }
    .home-news__text,
    .home-news__form { max-width: none; }
  }

  @media (max-width: 620px) {
    .home-news__card { padding: 24px; }
    .home-news__input { min-width: 0; flex: 1 1 100%; }
    .home-news__btn { flex: 1 1 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home — Newsletter",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay Connected With BODY अर्क." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Receive wellness insights, educational articles and exclusive content." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Email Address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe →" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for subscribing." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_block_start", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_block_end", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Home — Newsletter" }]
}
{% endschema %}
