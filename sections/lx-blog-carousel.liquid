{%- comment -%}
  Lust Xstore — Blog posts carousel.
  Desktop: 3 cards + peeking neighbours, arrows and progress dots.
  Mobile: 1 card + peek, native swipe via CSS scroll-snap. Whole card is a link.
  Posts come from the "Blog posts" picker, else the latest posts of the chosen blog.
{%- endcomment -%}

{% liquid
  assign limit = section.settings.post_limit
  if section.settings.featured_articles != blank
    assign posts = section.settings.featured_articles
    assign limit = section.settings.featured_articles.count
  elsif section.settings.blog != blank
    assign posts = section.settings.blog.articles
  endif

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and section.settings.blog != blank
    assign view_all_url = section.settings.blog.url
  endif

  assign heading_id = 'LxBlogHeading-' | append: section.id
%}

<section
  class="lx-blog"
  aria-labelledby="{{ heading_id }}"
  style="
    --lx-blog-bg: {{ section.settings.background_color }};
    --lx-blog-accent: {{ section.settings.accent_color }};
    --lx-blog-pad-top: {{ section.settings.padding_top }}px;
    --lx-blog-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="lx-blog__head">
    <div class="lx-blog__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="lx-blog__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="{{ heading_id }}" class="lx-blog__heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="lx-blog__sub">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>
    {% if section.settings.view_all_label != blank and view_all_url != blank %}
      <a class="lx-blog__view-all" href="{{ view_all_url }}">
        {{ section.settings.view_all_label | escape }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>

  <lx-blog-carousel class="lx-blog__carousel">
    <button
      type="button"
      class="lx-blog__arrow lx-blog__arrow--prev"
      aria-label="Previous posts"
      aria-controls="LxBlogTrack-{{ section.id }}"
      data-dir="-1"
      disabled
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <ul
      id="LxBlogTrack-{{ section.id }}"
      class="lx-blog__track"
      role="list"
      tabindex="0"
      aria-label="{{ section.settings.heading | escape }}"
    >
      {% if posts != blank %}
        {% for article in posts limit: limit %}
          {% liquid
            assign blog_handle = article.url | split: '/' | slice: 2 | first
            assign category = blogs[blog_handle].title
            if category == blank
              assign category = article.tags.first
            endif
            assign word_count = article.content | strip_html | split: ' ' | size
            assign read_minutes = word_count | divided_by: 200.0 | ceil
            if read_minutes < 1
              assign read_minutes = 1
            endif
            assign excerpt = article.excerpt_or_content | strip_html | truncatewords: 28
          %}
          <li class="lx-blog__slide">
            <a class="lx-card" href="{{ article.url }}">
              <div class="lx-card__media">
                {% if article.image %}
                  {{
                    article.image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '360, 480, 640, 800, 1000, 1200',
                      sizes: '(min-width: 990px) 400px, (min-width: 750px) 45vw, 82vw',
                      loading: 'lazy',
                      alt: article.image.alt | default: article.title
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'lx-card__placeholder' }}
                {% endif %}
              </div>
              <div class="lx-card__body">
                {% if category != blank %}
                  <span class="lx-card__tag">{{ category | escape }}</span>
                {% endif %}
                <h3 class="lx-card__title">{{ article.title | escape }}</h3>
                <p class="lx-card__meta">
                  <span>
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    {{ article.published_at | time_tag: format: 'date' }}
                  </span>
                  {% if section.settings.show_author and article.author != blank %}
                    <span>{{ article.author | escape }}</span>
                  {% endif %}
                  <span>
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    {{ read_minutes }} min read
                  </span>
                </p>
                {% if excerpt != blank %}
                  <p class="lx-card__excerpt">{{ excerpt }}</p>
                {% endif %}
                <span class="lx-card__cta">
                  Read article
                  <span class="lx-card__cta-arrow" aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </a>
          </li>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <li class="lx-blog__slide">
            <div class="lx-card lx-card--placeholder">
              <div class="lx-card__media">
                {{ 'image' | placeholder_svg_tag: 'lx-card__placeholder' }}
              </div>
              <div class="lx-card__body">
                <span class="lx-card__tag">Category</span>
                <h3 class="lx-card__title">Your blog post title</h3>
                <p class="lx-card__excerpt">Pick posts in the theme editor to fill this carousel.</p>
              </div>
            </div>
          </li>
        {% endfor %}
      {% endif %}
    </ul>

    <button
      type="button"
      class="lx-blog__arrow lx-blog__arrow--next"
      aria-label="Next posts"
      aria-controls="LxBlogTrack-{{ section.id }}"
      data-dir="1"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="lx-blog__dots" role="group" aria-label="Choose post"></div>
  </lx-blog-carousel>
</section>

<script>
  if (!customElements.get('lx-blog-carousel')) {
    customElements.define(
      'lx-blog-carousel',
      class extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('.lx-blog__track');
          this.slides = [...this.track.children];
          this.prev = this.querySelector('.lx-blog__arrow--prev');
          this.next = this.querySelector('.lx-blog__arrow--next');
          this.dotsWrap = this.querySelector('.lx-blog__dots');

          this.dots = this.slides.map((_, i) => {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'lx-blog__dot';
            dot.setAttribute('aria-label', `Go to post ${i + 1} of ${this.slides.length}`);
            dot.addEventListener('click', () => this.goTo(i));
            this.dotsWrap.append(dot);
            return dot;
          });

          [this.prev, this.next].forEach((btn) =>
            btn.addEventListener('click', () => this.goTo(this.current + Number(btn.dataset.dir)))
          );

          this.track.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') this.goTo(this.current + 1);
            if (e.key === 'ArrowLeft') this.goTo(this.current - 1);
          });

          this.onScroll = () => {
            if (this.raf) return;
            this.raf = requestAnimationFrame(() => {
              this.raf = null;
              this.update();
            });
          };
          this.track.addEventListener('scroll', this.onScroll, { passive: true });
          window.addEventListener('resize', this.onScroll, { passive: true });
          this.update();
        }

        disconnectedCallback() {
          window.removeEventListener('resize', this.onScroll);
        }

        get step() {
          const [a, b] = this.slides;
          return b ? b.offsetLeft - a.offsetLeft : this.track.clientWidth;
        }

        goTo(index) {
          const i = Math.max(0, Math.min(index, this.slides.length - 1));
          this.track.scrollTo({ left: this.slides[i].offsetLeft - this.slides[0].offsetLeft, behavior: 'smooth' });
        }

        update() {
          const max = this.track.scrollWidth - this.track.clientWidth;
          const left = this.track.scrollLeft;
          this.current = Math.round(left / this.step);
          if (left >= max - 4) this.current = this.slides.length - 1;
          this.dots.forEach((d, i) => d.setAttribute('aria-current', i === this.current ? 'true' : 'false'));
          this.prev.disabled = left <= 4;
          this.next.disabled = left >= max - 4;
          this.toggleAttribute('data-static', max <= 4);
        }
      }
    );
  }
</script>

{% stylesheet %}
  .lx-blog {
    --lx-blog-ink: #2b2522;
    --lx-blog-muted: #6f6460;
    --lx-blog-line: #efe3da;
    --lx-blog-card: #fffdfb;
    --lx-blog-gutter: max(16px, calc((100vw - 1240px) / 2));
    --lx-blog-gap: 20px;

    background: var(--lx-blog-bg);
    color: var(--lx-blog-ink);
    padding-block: var(--lx-blog-pad-top) var(--lx-blog-pad-bottom);
    overflow: clip;
  }

  .lx-blog__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-inline: var(--lx-blog-gutter);
    margin-bottom: 28px;
  }

  .lx-blog__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lx-blog-accent);
  }

  .lx-blog__eyebrow::before {
    content: '';
    width: 24px;
    height: 1px;
    background: currentColor;
  }

  .lx-blog__heading {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    color: var(--lx-blog-ink);
  }

  .lx-blog__sub {
    margin: 10px 0 0;
    max-width: 56ch;
    color: var(--lx-blog-muted);
    font-size: 1rem;
  }

  .lx-blog__view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    color: var(--lx-blog-accent);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .lx-blog__view-all span {
    transition: transform 0.25s ease;
  }

  .lx-blog__view-all:hover span {
    transform: translateX(4px);
  }

  .lx-blog__carousel {
    position: relative;
    display: block;
  }

  .lx-blog__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: var(--lx-blog-gap);
    margin: 0;
    padding: 8px var(--lx-blog-gutter) 24px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--lx-blog-gutter);
    scrollbar-width: none;
  }

  .lx-blog__track::-webkit-scrollbar {
    display: none;
  }

  .lx-blog__track:focus-visible {
    outline: 2px solid var(--lx-blog-accent);
    outline-offset: -2px;
  }

  .lx-blog__slide {
    scroll-snap-align: start;
    display: flex;
  }

  @media screen and (min-width: 750px) {
    .lx-blog__track {
      grid-auto-columns: calc((100% - var(--lx-blog-gap)) / 2.15);
    }
  }

  @media screen and (min-width: 990px) {
    .lx-blog {
      --lx-blog-gap: 24px;
      --lx-blog-gutter: max(72px, calc((100vw - 1240px) / 2));
    }

    .lx-blog__track {
      grid-auto-columns: calc((100% - 2 * var(--lx-blog-gap)) / 3);
    }
  }

  /* ---------- Card ---------- */
  .lx-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--lx-blog-card);
    border: 1px solid var(--lx-blog-line);
    border-radius: 20px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(43 37 34 / 0.04), 0 8px 24px -12px rgb(43 37 34 / 0.12);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .lx-card:focus-visible {
    outline: 2px solid var(--lx-blog-accent);
    outline-offset: 3px;
  }

  .lx-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #f3e9e2;
  }

  .lx-card__media img,
  .lx-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .lx-card__media {
    overflow: hidden;
  }

  .lx-card__tag {
    position: absolute;
    left: 20px;
    top: 0;
    transform: translateY(-50%);
    z-index: 1;
    padding: 6px 12px;
    border-radius: 999px;
    background: #f8ebe3;
    border: 1px solid #f0d9cb;
    color: var(--lx-blog-accent);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lx-card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 30px 22px 22px;
  }

  .lx-card__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.25;
    font-weight: 500;
    color: var(--lx-blog-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lx-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--lx-blog-muted);
  }

  .lx-card__meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .lx-card__excerpt {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--lx-blog-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lx-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 4px;
    color: var(--lx-blog-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .lx-card__cta-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .lx-card:hover {
      transform: translateY(-6px);
      border-color: var(--lx-blog-accent);
      box-shadow: 0 2px 4px rgb(43 37 34 / 0.05), 0 22px 40px -18px rgb(181 88 47 / 0.35);
    }

    .lx-card:hover .lx-card__media img {
      transform: scale(1.06);
    }

    .lx-card:hover .lx-card__cta-arrow {
      transform: translateX(5px);
    }
  }

  /* ---------- Controls ---------- */
  .lx-blog__arrow {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .lx-blog__arrow {
      position: absolute;
      top: 30%;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 52px;
      height: 52px;
      padding: 0;
      border: 1px solid var(--lx-blog-line);
      border-radius: 999px;
      background: #fff;
      color: var(--lx-blog-ink);
      box-shadow: 0 6px 20px -8px rgb(43 37 34 / 0.3);
      cursor: pointer;
      transition: background-color 0.25s ease, color 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
    }

    .lx-blog__arrow--prev {
      left: calc(var(--lx-blog-gutter) - 26px);
    }

    .lx-blog__arrow--next {
      right: calc(var(--lx-blog-gutter) - 26px);
    }

    .lx-blog__arrow:hover:not(:disabled) {
      background: var(--lx-blog-accent);
      border-color: var(--lx-blog-accent);
      color: #fff;
    }

    .lx-blog__arrow:disabled {
      opacity: 0;
      pointer-events: none;
    }

    .lx-blog__arrow:focus-visible {
      outline: 2px solid var(--lx-blog-accent);
      outline-offset: 3px;
    }
  }

  .lx-blog__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding-inline: var(--lx-blog-gutter);
  }

  .lx-blog__dot {
    width: 28px;
    height: 4px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #e6d8cf;
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  .lx-blog__dot[aria-current='true'] {
    width: 44px;
    background: var(--lx-blog-accent);
  }

  .lx-blog__dot:focus-visible {
    outline: 2px solid var(--lx-blog-accent);
    outline-offset: 4px;
  }

  .lx-blog__carousel[data-static] .lx-blog__dots {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .lx-blog__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .lx-card__body {
      padding: 28px 18px 20px;
    }

    .lx-card__title {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lx-blog__track {
      scroll-behavior: auto;
    }

    .lx-card,
    .lx-card__media img,
    .lx-card__cta-arrow,
    .lx-blog__dot {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts carousel",
  "tag": "div",
  "class": "section-lx-blog",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Blog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Blog posts" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wellness tips, mindful living, and expert guidance to help you feel your best every day."
    },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all articles" },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Defaults to the blog selected below."
    },
    { "type": "header", "content": "Posts" },
    {
      "type": "article_list",
      "id": "featured_articles",
      "label": "Blog posts",
      "info": "Pick posts in order. Leave empty to show the latest posts from the blog below.",
      "limit": 12
    },
    { "type": "blog", "id": "blog", "label": "Blog" },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of posts",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "visible_if": "{{ section.settings.featured_articles == blank }}"
    },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fbf6f1" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#9c4a26" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Blog posts carousel" }]
}
{% endschema %}
