{%- liquid
  assign per_page = section.settings.products_per_page
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
-%}

{%- paginate collection.products by per_page -%}
  <section class="lx-cg" id="lx-products" aria-label="{{ collection.title | escape }}">
    <div class="lx-cg__inner">
      <form
        class="lx-cg__toolbar"
        id="lx-cg-form-{{ section.id }}"
        action="{{ collection.url }}"
        method="get"
      >
        <p class="lx-cg__count">
          {%- if collection.products_count == 1 -%}
            1 product
          {%- else -%}
            {{ collection.products_count }} products
          {%- endif -%}
        </p>

        <div class="lx-cg__controls">
          {%- if section.settings.show_filters and collection.filters.size > 0 -%}
            <button type="button" class="lx-cg__filter-btn" data-lx-filter-open aria-haspopup="dialog">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 5h16l-6 7.5V19l-4-2v-4.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              Filter
              {%- if active_filter_count > 0 %}
                <span class="lx-cg__filter-count">{{ active_filter_count }}</span>
              {%- endif %}
            </button>
            <span class="lx-cg__divider" aria-hidden="true"></span>
          {%- endif -%}

          {%- if section.settings.show_sort -%}
            <label class="lx-cg__sort">
              <span class="lx-cg__sort-label"><span class="lx-cg__sort-long">Sort by:</span><span class="lx-cg__sort-short">Sort:</span></span>
              <select name="sort_by" data-lx-sort aria-label="Sort products">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
                {%- endfor -%}
              </select>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </label>
          {%- endif -%}
        </div>

        {%- comment -%} Keep active filters when only the sort changes {%- endcomment -%}
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}" data-lx-keep>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != null -%}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" data-lx-keep>{%- endif -%}
            {%- if filter.max_value.value != null -%}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" data-lx-keep>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </form>

      {%- if collection.products.size > 0 -%}
        <ul class="lx-cg__grid" role="list">
          {%- for product in collection.products -%}
            {%- liquid
              assign variant = product.selected_or_first_available_variant
              assign tagline = product.metafields.custom.tagline | default: settings.lx_cart_tagline
              assign badge = blank
              if product.compare_at_price > product.price
                assign badge = 'Sale'
              elsif settings.lx_cart_badge != blank
                assign badge = settings.lx_cart_badge
              endif
              if product.available == false
                assign badge = 'Sold out'
              endif
            -%}
            <li class="lx-cg__card">
              <div class="lx-cg__media">
                <a href="{{ product.url }}" class="lx-cg__media-link{% if product.media.size > 1 and section.settings.hover_image %} has-hover{% endif %}" tabindex="-1" aria-hidden="true">
                  {%- if product.featured_media -%}
                    {{
                      product.featured_media
                      | image_url: width: 900
                      | image_tag:
                        class: 'lx-cg__img',
                        loading: 'lazy',
                        widths: '360, 540, 720, 900',
                        sizes: '(min-width: 1200px) 380px, (min-width: 600px) 45vw, 92vw',
                        alt: product.featured_media.alt | default: product.title
                    }}
                    {%- assign hover_media = product.media | where: 'media_type', 'image' | slice: 1, 1 | first -%}
                    {%- if hover_media and section.settings.hover_image -%}
                      {{
                        hover_media
                        | image_url: width: 900
                        | image_tag:
                          class: 'lx-cg__img lx-cg__img--hover',
                          loading: 'lazy',
                          widths: '360, 540, 720, 900',
                          sizes: '(min-width: 1200px) 380px, (min-width: 600px) 45vw, 50vw',
                          alt: ''
                      }}
                    {%- endif -%}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'lx-cg__img lx-cg__img--placeholder' }}
                  {%- endif -%}
                </a>
                {%- if badge != blank -%}
                  <span class="lx-cg__badge">{{ badge }}</span>
                {%- endif -%}
                <button
                  type="button"
                  class="lx-cg__wish"
                  data-lx-wish="{{ product.id }}"
                  aria-pressed="false"
                  aria-label="Save {{ product.title | escape }}"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                </button>
              </div>

              <div class="lx-cg__body">
                <h2 class="lx-cg__title"><a href="{{ product.url }}">{{ product.title }}</a></h2>
                {%- if tagline != blank -%}
                  <p class="lx-cg__tagline">{{ tagline }}</p>
                {%- endif -%}
                <p class="lx-cg__price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="visually-hidden">Sale price</span>
                  {%- endif -%}
                  {%- if product.price_varies -%}From {% endif -%}
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price %}
                    <s class="lx-cg__compare"><span class="visually-hidden">Regular price</span>{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                </p>

                {%- if product.has_only_default_variant or product.variants.size == 1 -%}
                  <form class="lx-cg__add" action="{{ routes.cart_add_url }}" method="post" data-lx-add>
                    <input type="hidden" name="id" value="{{ variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="lx-cg__add-btn"{% unless variant.available %} disabled{% endunless %}>
                      <span data-lx-add-label>{% if variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
                    </button>
                    <p class="lx-cg__add-msg" role="status" data-lx-add-msg></p>
                  </form>
                {%- else -%}
                  <a class="lx-cg__add-btn" href="{{ product.url }}">Choose options</a>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="lx-cg__pages" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="lx-cg__page lx-cg__page--nav" aria-label="Previous page">‹</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="lx-cg__page">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="lx-cg__page is-current" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="lx-cg__page lx-cg__page--gap">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="lx-cg__page lx-cg__page--nav" aria-label="Next page">›</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="lx-cg__empty">
          <p>No products match these filters.</p>
          <a href="{{ collection.url }}?sort_by={{ sort_by }}">Clear filters</a>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_filters and collection.filters.size > 0 -%}
      <dialog class="lx-cg__panel" data-lx-filter-panel aria-labelledby="lx-cg-filter-title-{{ section.id }}">
        <form action="{{ collection.url }}" method="get" class="lx-cg__panel-form">
          <div class="lx-cg__panel-head">
            <h2 id="lx-cg-filter-title-{{ section.id }}">Filter</h2>
            <button type="button" class="lx-cg__panel-close" data-lx-filter-close aria-label="Close filters">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </button>
          </div>

          <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">

          <div class="lx-cg__panel-body">
            {%- for filter in collection.filters -%}
              <fieldset class="lx-cg__group">
                <legend>{{ filter.label | escape }}</legend>
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="lx-cg__range">
                      <label>
                        <span>From ({{ cart.currency.symbol }})</span>
                        <input
                          type="number"
                          inputmode="decimal"
                          min="0"
                          name="{{ filter.min_value.param_name }}"
                          placeholder="0"
                          {%- if filter.min_value.value != null %} value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                        >
                      </label>
                      <label>
                        <span>To ({{ cart.currency.symbol }})</span>
                        <input
                          type="number"
                          inputmode="decimal"
                          min="0"
                          name="{{ filter.max_value.param_name }}"
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          {%- if filter.max_value.value != null %} value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                        >
                      </label>
                    </div>
                  {%- else -%}
                    {%- for value in filter.values -%}
                      <label class="lx-cg__check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value | escape }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        <span>{{ value.label | escape }}</span>
                        <span class="lx-cg__check-count">{{ value.count }}</span>
                      </label>
                    {%- endfor -%}
                {%- endcase -%}
              </fieldset>
            {%- endfor -%}
          </div>

          <div class="lx-cg__panel-foot">
            <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="lx-cg__clear">Clear all</a>
            <button type="submit" class="lx-cg__apply">Show results</button>
          </div>
        </form>
      </dialog>
    {%- endif -%}
  </section>
{%- endpaginate -%}

<script type="module">
  import { morphSection } from '@theme/section-renderer';

  const sections = document.querySelectorAll('.lx-cg');
  const WISH_KEY = 'lx-wishlist';

  const readWish = () => {
    try { return JSON.parse(localStorage.getItem(WISH_KEY) || '[]'); } catch { return []; }
  };
  const writeWish = (ids) => {
    try { localStorage.setItem(WISH_KEY, JSON.stringify(ids)); } catch {}
  };

  sections.forEach((section) => {
    if (section.dataset.ready) return;
    section.dataset.ready = 'true';

    // Sort: submit on change (keeps any active filters via hidden inputs)
    section.querySelector('[data-lx-sort]')?.addEventListener('change', (e) => e.target.form.submit());

    // Filter panel
    const panel = section.querySelector('[data-lx-filter-panel]');
    section.querySelector('[data-lx-filter-open]')?.addEventListener('click', () => panel?.showModal());
    section.querySelector('[data-lx-filter-close]')?.addEventListener('click', () => panel?.close());
    panel?.addEventListener('click', (e) => { if (e.target === panel) panel.close(); });
    // Drop empty price inputs so the URL stays clean
    panel?.querySelector('form')?.addEventListener('submit', (e) => {
      e.currentTarget.querySelectorAll('input[type="number"]').forEach((input) => { if (!input.value) input.disabled = true; });
    });

    // Wishlist hearts (saved in this browser only)
    const saved = new Set(readWish());
    section.querySelectorAll('[data-lx-wish]').forEach((btn) => {
      const id = btn.dataset.lxWish;
      btn.setAttribute('aria-pressed', String(saved.has(id)));
      btn.addEventListener('click', () => {
        const ids = new Set(readWish());
        ids.has(id) ? ids.delete(id) : ids.add(id);
        writeWish([...ids]);
        btn.setAttribute('aria-pressed', String(ids.has(id)));
      });
    });

    // Add to cart: AJAX add, refresh the cart drawer + badge, then open the drawer
    section.querySelectorAll('[data-lx-add]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button');
        const label = form.querySelector('[data-lx-add-label]');
        const msg = form.querySelector('[data-lx-add-msg]');
        const original = label.textContent;
        btn.disabled = true;
        label.textContent = 'Adding…';
        msg.textContent = '';
        const drawer = document.getElementById('cart-drawer');
        drawer?.setAttribute('data-loading', '');
        if (drawer?.open && !drawer.isOpen) drawer.open();
        try {
          const body = new FormData(form);
          body.append('sections', 'cart-drawer-section');
          const res = await fetch(`${window.Shopify?.routes?.root || '/'}cart/add.js`, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body,
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.description || data.message || 'Could not add to cart');

          const drawerHtml = data.sections?.['cart-drawer-section'];
          if (drawerHtml) await morphSection('cart-drawer-section', drawerHtml, { mode: 'hydration' });

          const cart = await (await fetch(`${window.Shopify?.routes?.root || '/'}cart.js`)).json();
          document.querySelectorAll('cart-icon').forEach((icon) => icon.renderCartBubble?.(cart.item_count));

          if (!drawer?.open) window.location.href = `${window.Shopify?.routes?.root || '/'}cart`;

          label.textContent = original;
          btn.disabled = false;
        } catch (err) {
          drawer?.close?.();
          label.textContent = original;
          btn.disabled = false;
          msg.textContent = err.message;
        } finally {
          drawer?.removeAttribute('data-loading');
        }
      });
    });
  });
</script>

{% stylesheet %}
  .lx-cg {
    scroll-margin-top: 90px;
    --lx-cg-ink: #2f1f22;
    --lx-cg-muted: #6b5a5c;
    --lx-cg-accent: #95533c;
    --lx-cg-accent-dark: #7f4431;
    --lx-cg-accent-bg: #fbe9e1;
    --lx-cg-line: #efe1da;
    --lx-cg-surface: #fffcfa;

    background: var(--lx-cg-surface);
    color: var(--lx-cg-ink);
  }

  .lx-cg__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 18px 40px 72px;
  }

  /* Toolbar */
  .lx-cg__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--lx-cg-line);
  }

  .lx-cg__count {
    margin: 0;
    color: var(--lx-cg-muted);
    font-size: 0.92rem;
  }

  .lx-cg__controls {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .lx-cg__filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border: 1px solid var(--lx-cg-line);
    border-radius: 999px;
    background: #fff;
    color: var(--lx-cg-ink);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .lx-cg__filter-btn:hover {
    border-color: var(--lx-cg-accent);
    box-shadow: 0 4px 14px rgb(47 31 34 / 0.06);
  }

  .lx-cg__filter-count {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding-inline: 6px;
    border-radius: 999px;
    background: var(--lx-cg-accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .lx-cg__divider {
    width: 1px;
    height: 28px;
    background: var(--lx-cg-line);
  }

  .lx-cg__sort {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--lx-cg-ink);
    font-size: 0.95rem;
    cursor: pointer;
  }

  .lx-cg__sort-label { color: var(--lx-cg-muted); }
  .lx-cg__sort-short { display: none; }

  .lx-cg__sort select {
    appearance: none;
    padding: 8px 22px 8px 0;
    border: 0;
    background: transparent;
    color: var(--lx-cg-ink);
    font: inherit;
    cursor: pointer;
  }

  .lx-cg__sort svg {
    position: absolute;
    right: 0;
    pointer-events: none;
  }

  /* Grid */
  .lx-cg__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1100px) {
    .lx-cg__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    .lx-cg__grid:has(> :only-child) { grid-template-columns: minmax(0, 360px); }
  }

  .lx-cg__card {
    display: flex;
    flex-direction: column;
    padding: 10px;
    border: 1px solid var(--lx-cg-line);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 2px 10px rgb(47 31 34 / 0.03);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .lx-cg__card:hover {
    box-shadow: 0 14px 34px rgb(47 31 34 / 0.09);
    transform: translateY(-2px);
  }

  .lx-cg__media {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: #f7ede8;
    aspect-ratio: 1 / 1;
  }

  .lx-cg__media-link,
  .lx-cg__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lx-cg__img {
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .lx-cg__card:hover .lx-cg__img { transform: scale(1.03); }

  /* Second product image fades in on hover (mouse devices only) */
  .lx-cg__media-link { position: relative; }

  .lx-cg__img--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: #f7ede8;
    transition: opacity 0.45s ease, transform 0.5s ease;
  }

  @media (hover: hover) {
    .lx-cg__card:hover .lx-cg__img--hover,
    .lx-cg__media-link:focus-visible .lx-cg__img--hover { opacity: 1; }
  }

  @media (hover: none) {
    .lx-cg__img--hover { display: none; }
  }

  .lx-cg__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--lx-cg-accent-bg);
    color: var(--lx-cg-accent);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lx-cg__wish {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--lx-cg-ink);
    box-shadow: 0 2px 8px rgb(47 31 34 / 0.12);
    cursor: pointer;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .lx-cg__wish:hover { transform: scale(1.08); color: var(--lx-cg-accent); }
  .lx-cg__wish[aria-pressed='true'] { color: #b02d5c; }
  .lx-cg__wish[aria-pressed='true'] path { fill: currentColor; }

  .lx-cg__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 16px 8px 8px;
  }

  .lx-cg__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .lx-cg__title a {
    color: var(--lx-cg-ink);
    text-decoration: none;
  }

  .lx-cg__title a:hover { color: var(--lx-cg-accent); }

  .lx-cg__tagline {
    margin: 8px 0 0;
    color: var(--lx-cg-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .lx-cg__price {
    margin: 14px 0 16px;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--lx-cg-ink);
  }

  .lx-cg__compare {
    margin-left: 8px;
    color: var(--lx-cg-muted);
    font-size: 0.95rem;
    font-weight: 400;
  }

  .lx-cg__add { margin-top: auto; }

  .lx-cg__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    margin-top: auto;
    padding: 0 20px;
    border: 0;
    border-radius: 10px;
    background: var(--lx-cg-accent);
    color: #fff;
    font: inherit;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lx-cg__add-btn:hover { background: var(--lx-cg-accent-dark); }
  .lx-cg__add-btn:disabled { background: #c9b4ac; cursor: not-allowed; }

  .lx-cg__add-msg {
    margin: 6px 0 0;
    color: #b3261e;
    font-size: 0.82rem;
  }

  .lx-cg__add-msg:empty { display: none; }

  /* Pagination */
  .lx-cg__pages {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 40px;
  }

  .lx-cg__page {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding-inline: 10px;
    border: 1px solid var(--lx-cg-line);
    border-radius: 999px;
    color: var(--lx-cg-ink);
    text-decoration: none;
  }

  .lx-cg__page.is-current {
    border-color: var(--lx-cg-accent);
    background: var(--lx-cg-accent);
    color: #fff;
  }

  .lx-cg__page--gap { border: 0; }

  .lx-cg__empty {
    padding: 60px 0;
    color: var(--lx-cg-muted);
    text-align: center;
  }

  .lx-cg__empty a { color: var(--lx-cg-accent); }

  /* Filter panel */
  .lx-cg__panel {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(420px, 100%);
    max-width: 100%;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--lx-cg-surface);
    color: var(--lx-cg-ink);
    box-shadow: -12px 0 40px rgb(47 31 34 / 0.12);
  }

  .lx-cg__panel[open] { animation: lx-cg-slide 0.28s ease; }

  .lx-cg__panel::backdrop {
    background: rgb(47 31 34 / 0.38);
    backdrop-filter: blur(2px);
  }

  @keyframes lx-cg-slide {
    from { transform: translateX(100%); }
  }

  .lx-cg__panel-form {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .lx-cg__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px;
    border-bottom: 1px solid var(--lx-cg-line);
  }

  .lx-cg__panel-head h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.6rem;
    font-weight: 500;
  }

  .lx-cg__panel-close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--lx-cg-ink);
    box-shadow: 0 4px 14px rgb(47 31 34 / 0.08);
    cursor: pointer;
  }

  .lx-cg__panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 8px 24px 24px;
  }

  .lx-cg__group {
    margin: 0;
    padding: 18px 0;
    border: 0;
    border-bottom: 1px solid var(--lx-cg-line);
  }

  .lx-cg__group legend {
    float: left;
    width: 100%;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .lx-cg__check {
    clear: both;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    cursor: pointer;
  }

  .lx-cg__check input { width: 18px; height: 18px; accent-color: var(--lx-cg-accent); }
  .lx-cg__check-count { margin-left: auto; color: var(--lx-cg-muted); font-size: 0.85rem; }
  .lx-cg__check.is-disabled { opacity: 0.45; cursor: not-allowed; }

  .lx-cg__range {
    clear: both;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .lx-cg__range label {
    display: grid;
    gap: 6px;
    color: var(--lx-cg-muted);
    font-size: 0.85rem;
  }

  .lx-cg__range input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--lx-cg-line);
    border-radius: 10px;
    background: #fff;
    font: inherit;
  }

  .lx-cg__panel-foot {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 24px 24px;
    border-top: 1px solid var(--lx-cg-line);
  }

  .lx-cg__clear {
    color: var(--lx-cg-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lx-cg__apply {
    flex: 1;
    min-height: 50px;
    border: 0;
    border-radius: 12px;
    background: var(--lx-cg-accent);
    color: #fff;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  @media (max-width: 749px) {
    .lx-cg__inner { padding: 16px 16px 48px; }

    .lx-cg__toolbar {
      flex-wrap: wrap;
      gap: 10px;
      padding-bottom: 12px;
      margin-bottom: 18px;
    }

    .lx-cg__count { width: 100%; }
    .lx-cg__controls { width: 100%; justify-content: space-between; }
    .lx-cg__sort-long { display: none; }
    .lx-cg__sort-short { display: inline; }
    /* Two products per row on phones */
    .lx-cg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .lx-cg__card {
      padding: 6px;
      border-radius: 14px;
    }

    .lx-cg__card:hover { transform: none; }
    .lx-cg__media { border-radius: 10px; }

    .lx-cg__badge {
      top: 8px;
      left: 8px;
      padding: 3px 7px;
      font-size: 0.56rem;
      letter-spacing: 0.06em;
    }

    .lx-cg__wish {
      top: 6px;
      right: 6px;
      width: 30px;
      height: 30px;
    }

    .lx-cg__wish svg { width: 15px; height: 15px; }
    .lx-cg__body { padding: 10px 4px 4px; }

    .lx-cg__title {
      font-size: 0.92rem;
      line-height: 1.3;
    }

    .lx-cg__tagline {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-top: 4px;
      font-size: 0.76rem;
      line-height: 1.4;
    }

    .lx-cg__price {
      margin: 8px 0 10px;
      font-size: 0.95rem;
    }

    .lx-cg__compare { margin-left: 4px; font-size: 0.78rem; }

    .lx-cg__add-btn {
      min-height: 40px;
      padding: 0 8px;
      border-radius: 8px;
      font-size: 0.85rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection products",
  "tag": "div",
  "class": "lx-cg-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 12
    },
    { "type": "checkbox", "id": "show_filters", "label": "Show filter", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort", "default": true },
    { "type": "checkbox", "id": "hover_image", "label": "Show second image on hover", "default": true },
    {
      "type": "paragraph",
      "content": "The badge and tagline come from Theme settings → Cart → Cart drawer (Lust Xstore). A product metafield custom.tagline overrides the tagline."
    }
  ],
  "presets": [{ "name": "Collection products" }]
}
{% endschema %}
