{%- liquid
  assign heading = section.settings.heading | default: collection.title
  assign alt = section.settings.alt | default: heading | escape
  assign desktop = section.settings.image
  assign mobile = section.settings.image_mobile | default: desktop
  assign link = section.settings.link
-%}

<div class="lx-ib{% if section.settings.full_width == false %} lx-ib--contained{% endif %}">
  {%- if link != blank -%}<a href="{{ link }}" class="lx-ib__link">{%- endif -%}

  {%- if section.settings.show_heading -%}
    <h1 class="visually-hidden">{{ heading }}</h1>
  {%- endif -%}

  <picture class="lx-ib__picture">
    {%- if desktop != blank -%}
      {%- if mobile != desktop -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ mobile | image_url: width: 600 }} 600w, {{ mobile | image_url: width: 900 }} 900w, {{ mobile | image_url: width: 1200 }} 1200w"
          sizes="100vw"
          width="{{ mobile.width }}"
          height="{{ mobile.height }}"
        >
      {%- endif -%}
      {{
        desktop
        | image_url: width: 2400
        | image_tag:
          class: 'lx-ib__img',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: alt
      }}
    {%- else -%}
      {%- if section.settings.image_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ mobile | image_url: width: 600 }} 600w, {{ mobile | image_url: width: 900 }} 900w, {{ mobile | image_url: width: 1200 }} 1200w"
          sizes="100vw"
          width="{{ mobile.width }}"
          height="{{ mobile.height }}"
        >
      {%- else -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ 'lx-collection-banner-mobile-640.webp' | asset_url }} 640w, {{ 'lx-collection-banner-mobile.webp' | asset_url }} 1024w"
          sizes="100vw"
          width="1024"
          height="1536"
        >
      {%- endif -%}
      <img
        class="lx-ib__img"
        src="{{ 'lx-collection-banner.webp' | asset_url }}"
        srcset="{{ 'lx-collection-banner-1200.webp' | asset_url }} 1200w, {{ 'lx-collection-banner.webp' | asset_url }} 2000w"
        sizes="100vw"
        alt="{{ alt }}"
        width="2000"
        height="751"
        fetchpriority="high"
      >
    {%- endif -%}
  </picture>

  {%- if link != blank -%}</a>{%- endif -%}
</div>

{% stylesheet %}
  .lx-ib {
    background: #f8ece0;
    line-height: 0;
  }

  .lx-ib--contained {
    max-width: 1280px;
    margin: 24px auto 0;
    padding-inline: 40px;
    background: transparent;
  }

  .lx-ib--contained .lx-ib__img { border-radius: 20px; }

  .lx-ib__link { display: block; }

  .lx-ib__picture { display: block; }

  .lx-ib__img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 749px) {
    .lx-ib--contained {
      margin-top: 12px;
      padding-inline: 16px;
    }

    .lx-ib--contained .lx-ib__img { border-radius: 14px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "lx-ib-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Recommended 2000 × 750 px. Leave blank to use the default wellness kits banner."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Shown on phones (up to 749px wide). Recommended 1024 × 1536 px. Leave blank to use the default mobile banner."
    },
    { "type": "url", "id": "link", "label": "Link", "info": "Makes the whole banner clickable." },
    { "type": "text", "id": "alt", "label": "Image description (alt text)", "default": "Daily Wellness for a Stronger You — BODY अर्क® wellness kits" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Add hidden page heading (SEO)",
      "info": "Search engines and screen readers read this; it isn't shown on the page.",
      "default": true
    },
    { "type": "text", "id": "heading", "label": "Hidden heading", "info": "Leave blank to use the collection title.", "default": "Daily Wellness for a Stronger You" }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
