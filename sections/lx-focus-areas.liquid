{%- comment -%}
  Lust Xstore — "Our wellness focus areas" cards.
  Split from the homepage; styles live in assets/lx-home.css.
{%- endcomment -%}
{% assign card_count = section.blocks.size %}
<section class="lx-h lx-focus" style="--lx-pad-top: {{ section.settings.padding_top }}px; --lx-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="lx-h__wrap">
    <h2 class="lx-h__rule"><span>{{ section.settings.heading | escape }}</span></h2>

    <ul class="lx-swipe lx-focus__list" role="list" style="--cols: {{ card_count | at_most: 4 | at_least: 1 }}; --cols-tablet: 2; --swipe-w: 72%;">
      {% for block in section.blocks %}
        {% assign f = block.settings %}
        <li class="lx-focus__item" style="--fa-accent: {{ f.accent }}; --fa-tint: {{ f.tint }};" {{ block.shopify_attributes }}>
          <span class="lx-focus__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="lx-focus__card">
            <span class="lx-focus__orb">
              <span class="lx-focus__spark lx-focus__spark--a" aria-hidden="true">✦</span>
              <span class="lx-focus__spark lx-focus__spark--b" aria-hidden="true">✦</span>
              {% render 'lx-icon', icon: f.icon, size: 40, stroke: 1.6 %}
            </span>
            <h3>{{ f.title | escape }}</h3>
            <p>{{ f.text | escape }}</p>
            <span class="lx-focus__bar" aria-hidden="true"></span>
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Focus areas",
  "tag": "div",
  "class": "section-lx-focus-areas",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our wellness focus areas"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "area",
      "name": "Focus area",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "lotus",
              "label": "Lotus"
            },
            {
              "value": "sprout",
              "label": "Sprout"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "calm",
              "label": "Calm"
            },
            {
              "value": "sun",
              "label": "Sun"
            },
            {
              "value": "moon",
              "label": "Moon"
            }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feminine Confidence"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Accent",
          "default": "#bf3a59"
        },
        {
          "type": "color",
          "id": "tint",
          "label": "Tint",
          "default": "#fbe8ef"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Focus areas"
    }
  ]
}
{% endschema %}
