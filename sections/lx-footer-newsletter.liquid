{%- comment -%}
  Lust Xstore — footer brand + newsletter band (sits above the link footer).
  Left: logo, tagline and description. Right: "Join the community" signup card.
{%- endcomment -%}

<div
  class="lx-fnews"
  style="
    --lx-fnews-bg: {{ section.settings.background_color }};
    --lx-fnews-accent: {{ section.settings.button_color }};
    --lx-fnews-pad-top: {{ section.settings.padding_top }}px;
    --lx-fnews-pad-bottom: {{ section.settings.padding_bottom }}px;
    --lx-fnews-pad-x: {{ section.settings.padding_x }}px;
    --lx-fnews-space-below: {{ section.settings.space_below }}px;
    --lx-fnews-space-color: {{ section.settings.space_below_color }};
  "
>
  <div class="lx-fnews__inner{% unless section.settings.show_brand %} lx-fnews__inner--card-only{% endunless %}">
    {% if section.settings.show_brand %}
    <div class="lx-fnews__brand">
      <a href="{{ routes.root_url }}" class="lx-fnews__logo">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 900 | image_tag: alt: shop.name, loading: 'lazy' }}
        {% else %}
          <img
            src="{{ 'lustxstore-logo-dark.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="1600"
            height="331"
            loading="lazy"
          >
        {% endif %}
        {% if section.settings.tagline != blank %}
          <span class="lx-fnews__tagline">{{ section.settings.tagline | escape }}</span>
        {% endif %}
      </a>
      {% if section.settings.description != blank %}
        <p class="lx-fnews__desc">{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>
    {% endif %}

    <div class="lx-fnews__card">
      <img
        class="lx-fnews__leaf"
        src="{{ 'lx-footer-leaf.png' | asset_url }}"
        alt=""
        width="259"
        height="332"
        loading="lazy"
        aria-hidden="true"
      >
      <div class="lx-fnews__card-body">
        {% if section.settings.eyebrow != blank %}
          <p class="lx-fnews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2 class="lx-fnews__heading">{{ section.settings.heading | escape | replace: '®', '<sup>®</sup>' }}</h2>
        {% if section.settings.text != blank %}
          <p class="lx-fnews__text">{{ section.settings.text | escape }}</p>
        {% endif %}

        {%- form 'customer', id: 'LxFooterNewsletter', class: 'lx-fnews__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {% if form.posted_successfully? %}
            <p class="lx-fnews__msg" role="status">Thanks for subscribing! Check your inbox soon.</p>
          {% else %}
            <label class="lx-fnews__field">
              <span class="visually-hidden">Email address</span>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
              <input
                type="email"
                name="contact[email]"
                autocomplete="email"
                placeholder="Your email address"
                required
              >
            </label>
            <button type="submit">
              {{ section.settings.button_label | escape }}
              <span aria-hidden="true">&rarr;</span>
            </button>
            {% if form.errors %}
              <p class="lx-fnews__msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {% endif %}
          {% endif %}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .lx-fnews {
    background: var(--lx-fnews-bg);
    color: #f3e6ea;
    padding: var(--lx-fnews-pad-top) var(--lx-fnews-pad-x) var(--lx-fnews-pad-bottom);
    border-bottom: var(--lx-fnews-space-below, 0px) solid var(--lx-fnews-space-color, #fff);
  }

  .lx-fnews__inner {
    display: grid;
    gap: 32px;
    width: 100%;
    max-width: 1480px;
    margin-inline: auto;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .lx-fnews__inner {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
      gap: 56px;
    }

    .lx-fnews__inner--card-only {
      grid-template-columns: minmax(0, 1fr);
    }

    .lx-fnews__inner--card-only .lx-fnews__card-body {
      padding: 48px 340px 48px clamp(48px, 9vw, 170px);
    }

    .lx-fnews__inner--card-only .lx-fnews__form {
      max-width: 820px;
    }

    .lx-fnews__inner--card-only .lx-fnews__text {
      max-width: 60ch;
      font-size: 1.0625rem;
    }

    .lx-fnews__inner--card-only .lx-fnews__heading {
      font-size: clamp(2rem, 3.2vw, 2.75rem);
    }
  }

  /* ---------- Brand ---------- */
  .lx-fnews__logo {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
  }

  .lx-fnews__logo img {
    width: min(100%, 320px);
    height: auto;
  }

  .lx-fnews__tagline {
    margin: 6px 0 0 27%;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #e9c7b9;
  }

  .lx-fnews__desc {
    max-width: 34ch;
    margin: 22px 0 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #e8d9dd;
  }

  /* ---------- Card ---------- */
  .lx-fnews__card {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background: linear-gradient(110deg, #fdf0ea 0%, #fbe7df 55%, #f8ddd2 100%);
    color: #3a1a24;
    box-shadow: 0 24px 50px -28px rgb(0 0 0 / 0.6);
  }

  .lx-fnews__leaf {
    position: absolute;
    right: 0;
    bottom: 0;
    height: 100%;
    width: auto;
    max-height: 340px;
    pointer-events: none;
    opacity: 0.9;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 30%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 30%);
  }

  .lx-fnews__card-body {
    position: relative;
    padding: 28px 22px;
  }

  @media screen and (min-width: 750px) {
    .lx-fnews__card-body {
      padding: 40px 260px 40px 48px;
    }
  }

  @media screen and (max-width: 749px) {
    .lx-fnews__leaf {
      height: 70%;
      opacity: 0.35;
    }
  }

  .lx-fnews__eyebrow {
    margin: 0 0 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #a0545c;
  }

  .lx-fnews__heading {
    margin: 0 0 12px;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    color: #2a1018;
  }

  .lx-fnews__heading sup {
    font-size: 0.45em;
  }

  .lx-fnews__text {
    max-width: 52ch;
    margin: 0 0 24px;
    font-size: 1rem;
    line-height: 1.6;
    color: #6a4a52;
  }

  .lx-fnews__form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 640px;
  }

  .lx-fnews__field {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1 1 260px;
    min-height: 54px;
    padding: 0 18px;
    border: 1px solid #f0d4cb;
    border-radius: 999px;
    background: #fff;
    color: #7b5a62;
    cursor: text;
  }

  .lx-fnews__field:focus-within {
    border-color: var(--lx-fnews-accent);
    box-shadow: 0 0 0 3px rgb(194 24 91 / 0.15);
  }

  .lx-fnews__field input {
    flex: 1;
    min-width: 0;
    height: 52px;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 1rem;
    color: #2a1018;
  }

  .lx-fnews__field input::placeholder {
    color: #8a6b72;
  }

  .lx-fnews__form button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 54px;
    padding: 0 30px;
    border: 0;
    border-radius: 999px;
    background: var(--lx-fnews-accent);
    color: #fff;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 10px 22px -12px var(--lx-fnews-accent);
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .lx-fnews__form button:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .lx-fnews__form button span {
    transition: transform 0.2s ease;
  }

  .lx-fnews__form button:hover span {
    transform: translateX(3px);
  }

  @media screen and (max-width: 749px) {
    .lx-fnews__form button {
      flex: 1 1 100%;
    }
  }

  .lx-fnews__msg {
    flex-basis: 100%;
    margin: 4px 0 0;
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer newsletter",
  "tag": "section",
  "class": "section-lx-fnews",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "checkbox", "id": "show_brand", "label": "Show brand column", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Defaults to the Lust Xstore logo." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Your wellness partner" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Thoughtfully designed wellness experiences inspired by nature, guided by science and created for everyday life."
    },
    { "type": "header", "content": "Newsletter card" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay connected" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the BODY अर्क® Community" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Get wellness insights, educational articles, product updates and exclusive content straight to your inbox."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1c0812" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#c2185b" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_x", "label": "Side padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "space_below", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "space_below_color", "label": "Space below colour", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Footer newsletter" }]
}
{% endschema %}
