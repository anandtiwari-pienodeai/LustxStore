{%- comment -%}
  Lust Xstore — main footer.
  Top: brand column (logo, tagline, description, socials) · link columns · contact column.
  Optional trust row (badges, licence, quote) · bottom bar (logo, copyright, tagline,
  socials, back to top). Blocks: "Link column", "Contact column", "Trust badge".
{%- endcomment -%}

{% liquid
  if section.settings.background_image != blank
    assign bg_url = section.settings.background_image | image_url: width: 2400
  else
    assign bg_url = 'lx-footer-bg.webp' | asset_url
  endif

  assign socials = 'instagram,facebook,youtube,pinterest,linkedin,x' | split: ','
  assign has_social = false
  for s in socials
    assign key = s | append: '_url'
    if section.settings[key] != blank
      assign has_social = true
    endif
  endfor

  assign badge_count = 0
  for block in section.blocks
    if block.type == 'badge'
      assign badge_count = badge_count | plus: 1
    endif
  endfor
%}

{%- capture logo_markup -%}
  <a href="{{ routes.root_url }}" class="lx-footer__logo">
    {% if section.settings.logo != blank %}
      {{ section.settings.logo | image_url: width: 600 | image_tag: alt: shop.name, loading: 'lazy' }}
    {% else %}
      <img src="{{ 'lustxstore-logo-dark.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="1600" height="331" loading="lazy">
    {% endif %}
    {% if section.settings.logo_tagline != blank %}
      <span class="lx-footer__logo-tagline">{{ section.settings.logo_tagline | escape }}</span>
    {% endif %}
  </a>
{%- endcapture -%}

{%- capture social_markup -%}
  {% if has_social %}
    <ul class="lx-footer__social" role="list">
      {% for s in socials %}
        {% assign key = s | append: '_url' %}
        {% if section.settings[key] != blank %}
          <li>
            <a href="{{ section.settings[key] }}" target="_blank" rel="noopener" aria-label="{{ s | capitalize }}">
              {% render 'lx-footer-icon', icon: s %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
{%- endcapture -%}

<footer
  class="lx-footer"
  style="
    --lx-footer-bg: {{ section.settings.background_color }};
    --lx-footer-bg-image: url('{{ bg_url }}');
    --lx-footer-bottom-bg: {{ section.settings.bottom_background_color }};
    --lx-footer-accent: {{ section.settings.accent_color }};
    --lx-footer-pad-top: {{ section.settings.padding_top }}px;
  "
>
  <div class="lx-footer__main">
    <div class="lx-footer__wrap lx-footer__grid">
      {%- comment -%} ---------- Brand ---------- {%- endcomment -%}
      <div class="lx-footer__brand">
        {{ logo_markup }}
        {% if section.settings.description != blank %}
          <p class="lx-footer__desc">{{ section.settings.description | escape }}</p>
        {% endif %}
        {{ social_markup }}
      </div>

      {%- comment -%} ---------- Link columns ---------- {%- endcomment -%}
      <div class="lx-footer__links">
        {% for block in section.blocks %}
          {% if block.type == 'links' %}
            <nav class="lx-footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              <h2 class="lx-footer__heading">{{ block.settings.heading | escape }}</h2>
              <ul role="list">
                {% if block.settings.menu != blank %}
                  {% for link in block.settings.menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {% endfor %}
                {% else %}
                  {% for i in (1..6) %}
                    {% liquid
                      assign label_key = 'label_' | append: i
                      assign url_key = 'url_' | append: i
                      assign label = block.settings[label_key]
                      assign url = block.settings[url_key]
                    %}
                    {% if label != blank %}
                      <li>
                        {% if url != blank %}
                          <a href="{{ url }}">{{ label | escape }}</a>
                        {% else %}
                          <span>{{ label | escape }}</span>
                        {% endif %}
                      </li>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </ul>
            </nav>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%} ---------- Contact ---------- {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'contact' %}
          <div class="lx-footer__contact-col" {{ block.shopify_attributes }}>
            <h2 class="lx-footer__heading lx-footer__heading--plain">{{ block.settings.heading | escape }}</h2>
            <ul role="list" class="lx-footer__contact">
              {% if block.settings.support_email != blank %}
                <li>
                  <span class="lx-footer__contact-icon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 5h16v11H8l-4 3.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>
                  <span><strong>{{ block.settings.support_label | remove: ':' | escape }}</strong><a href="mailto:{{ block.settings.support_email }}">{{ block.settings.support_email | escape }}</a></span>
                </li>
              {% endif %}
              {% if block.settings.business_email != blank %}
                <li>
                  <span class="lx-footer__contact-icon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9.6 9.5a2.4 2.4 0 1 1 3.3 2.2c-.6.3-.9.8-.9 1.4v.4M12 16.5h.01" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
                  <span><strong>{{ block.settings.business_label | remove: ':' | escape }}</strong><a href="mailto:{{ block.settings.business_email }}">{{ block.settings.business_email | escape }}</a></span>
                </li>
              {% endif %}
              {% if block.settings.hours != blank %}
                <li>
                  <span class="lx-footer__contact-icon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
                  <span><strong>{{ block.settings.hours_label | remove: ':' | escape }}</strong>{{ block.settings.hours | escape | newline_to_br }}</span>
                </li>
              {% endif %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {%- comment -%} ---------- Optional trust row ---------- {%- endcomment -%}
    {% if section.settings.show_trust_row %}
      <div class="lx-footer__wrap">
        <div class="lx-footer__trust">
          {% if badge_count > 0 %}
            <ul class="lx-footer__badges" role="list">
              {% for block in section.blocks %}
                {% if block.type == 'badge' %}
                  <li {{ block.shopify_attributes }}>
                    {% render 'lx-footer-icon', icon: block.settings.icon %}
                    <span>{{ block.settings.label | escape }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
          {% if section.settings.licence_text != blank %}
            <div class="lx-footer__licence">{{ section.settings.licence_text }}</div>
          {% endif %}
          {% if section.settings.quote != blank %}
            <p class="lx-footer__quote">{{ section.settings.quote | escape }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  {%- comment -%} ---------- Bottom bar ---------- {%- endcomment -%}
  <div class="lx-footer__bottom">
    <div class="lx-footer__wrap lx-footer__bottom-row">
      {{ logo_markup }}
      {% if section.settings.copyright != blank %}
        <div class="lx-footer__copyright">{{ section.settings.copyright }}</div>
      {% endif %}
      {% if section.settings.tagline != blank %}
        <div class="lx-footer__motto">
          <svg viewBox="0 0 48 48" width="40" height="40" aria-hidden="true"><path d="M24 26c0-9 6-15 16-16-1 10-7 16-16 16zM24 30c0-7-5-12-13-13 1 8 6 13 13 13z" fill="currentColor" fill-opacity=".85"/><path d="M24 42V26" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <p>{{ section.settings.tagline | escape | newline_to_br }}</p>
        </div>
      {% endif %}
      <div class="lx-footer__bottom-end">
        {{ social_markup }}
        {% if section.settings.show_back_to_top %}
          <a href="#MainContent" class="lx-footer__top" aria-label="Back to top" data-lx-back-to-top>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll('[data-lx-back-to-top]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      // Desktop scrolls inside .page-wrapper, mobile scrolls the document.
      const wrapper = document.querySelector('.page-wrapper');
      const scroller = wrapper && wrapper.scrollHeight > wrapper.clientHeight ? wrapper : window;
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      scroller.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
      document.getElementById('MainContent')?.focus({ preventScroll: true });
    });
  });
</script>

{% stylesheet %}
  .lx-footer {
    --lx-footer-ink: #f3e7ea;
    --lx-footer-soft: #d8c1c9;
    --lx-footer-line: rgb(255 255 255 / 0.09);

    background: var(--lx-footer-bg);
    color: var(--lx-footer-ink);
    font-size: 0.9375rem;
  }

  .lx-footer__wrap {
    width: 100%;
    max-width: 1480px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  @media screen and (min-width: 990px) {
    .lx-footer__wrap {
      padding-inline: 56px;
    }
  }

  .lx-footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .lx-footer__main {
    background: var(--lx-footer-bg) var(--lx-footer-bg-image) center / cover no-repeat;
  }

  /* ---------- Top grid ---------- */
  .lx-footer__grid {
    display: grid;
    gap: 40px;
    padding-block: max(var(--lx-footer-pad-top), 48px) 48px;
  }

  @media screen and (min-width: 1200px) {
    .lx-footer__grid {
      grid-template-columns: minmax(0, 260px) minmax(0, 1fr) minmax(0, 270px);
      gap: 40px;
      align-items: stretch;
    }
  }

  /* Brand */
  .lx-footer__logo {
    display: inline-flex;
    flex-direction: column;
  }

  .lx-footer__logo img {
    width: 230px;
    height: auto;
  }

  .lx-footer__logo-tagline {
    margin: 2px 0 0 27%;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #eadbe0;
  }

  .lx-footer__desc {
    max-width: 32ch;
    margin: 22px 0 24px;
    line-height: 1.6;
    color: var(--lx-footer-ink);
  }

  .lx-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lx-footer__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.07);
    color: #fff;
  }

  .lx-footer__social a:hover {
    background: var(--lx-footer-accent);
  }

  /* Link columns */
  .lx-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 24px;
  }

  @media screen and (min-width: 750px) {
    .lx-footer__links {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 36px 20px;
    }
  }

  @media screen and (min-width: 1200px) and (max-width: 1599px) {
    .lx-footer__col li > a,
    .lx-footer__col li > span {
      font-size: 0.875rem;
    }

    .lx-footer__contact-col {
      padding-left: 36px;
    }
  }

  .lx-footer__heading {
    margin: 0 0 14px;
    padding-bottom: 14px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(var(--lx-footer-accent), var(--lx-footer-accent)) no-repeat left bottom / 36px 2px;
  }

  .lx-footer__heading--plain {
    margin-bottom: 24px;
    padding-bottom: 0;
    background: none;
  }

  .lx-footer__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lx-footer__col li {
    border-bottom: 1px solid var(--lx-footer-line);
  }

  .lx-footer__col li > a,
  .lx-footer__col li > span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-block: 13px;
    color: var(--lx-footer-ink);
  }

  .lx-footer__col li > a::after {
    content: '';
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-top: 1.6px solid var(--lx-footer-accent);
    border-right: 1.6px solid var(--lx-footer-accent);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  .lx-footer__col li > span {
    color: var(--lx-footer-soft);
  }

  .lx-footer__col li > a:hover {
    color: #fff;
  }

  .lx-footer__col li > a:hover::after {
    transform: translateX(3px) rotate(45deg);
  }

  /* Contact column */
  @media screen and (min-width: 1200px) {
    .lx-footer__contact-col {
      padding-left: 44px;
      border-left: 1px solid var(--lx-footer-line);
    }
  }

  .lx-footer__contact {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lx-footer__contact li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    line-height: 1.55;
    color: var(--lx-footer-soft);
  }

  .lx-footer__contact-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: rgb(224 112 132 / 0.16);
    color: #f08ca1;
  }

  .lx-footer__contact strong {
    display: block;
    margin-bottom: 2px;
    color: #fff;
    font-weight: 600;
  }

  .lx-footer__contact a:hover {
    color: #fff;
  }

  /* ---------- Trust row (optional) ---------- */
  .lx-footer__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 28px;
    border-top: 1px solid var(--lx-footer-line);
  }

  .lx-footer__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lx-footer__badges li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    max-width: 96px;
    text-align: center;
    font-size: 0.75rem;
    color: var(--lx-footer-soft);
  }

  .lx-footer__badges svg {
    color: var(--lx-footer-accent);
  }

  .lx-footer__licence {
    padding: 12px 16px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.05);
    font-size: 0.8125rem;
  }

  .lx-footer__licence p,
  .lx-footer__quote {
    margin: 0;
  }

  .lx-footer__quote {
    font-style: italic;
    color: #e9a77f;
  }

  /* ---------- Bottom bar ---------- */
  .lx-footer__bottom {
    background: var(--lx-footer-bottom-bg);
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .lx-footer__bottom-row {
    display: grid;
    gap: 24px;
    padding-block: 28px;
    justify-items: center;
    text-align: center;
  }

  .lx-footer__bottom .lx-footer__logo img {
    width: 190px;
  }

  .lx-footer__copyright {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--lx-footer-soft);
  }

  .lx-footer__copyright p {
    margin: 0;
  }

  .lx-footer__motto {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #b5505f;
  }

  .lx-footer__motto p {
    margin: 0;
    font-style: italic;
    line-height: 1.6;
    text-align: left;
    color: #e3a6a2;
  }

  .lx-footer__bottom-end {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 20px;
  }

  .lx-footer__top {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    border-radius: 999px;
    background: #e46e78;
    color: #fff;
    box-shadow: 0 10px 22px -10px rgb(228 110 120 / 0.8);
  }

  .lx-footer__top:hover {
    background: #ee7f88;
    transform: translateY(-2px);
  }

  @media screen and (min-width: 990px) {
    .lx-footer__bottom-row {
      grid-template-columns: auto auto 1fr auto;
      justify-items: start;
      align-items: center;
      text-align: left;
      gap: 40px;
    }

    .lx-footer__motto {
      padding-left: 40px;
      border-left: 1px solid var(--lx-footer-line);
    }

    .lx-footer__bottom-end {
      justify-self: end;
      flex-wrap: nowrap;
    }

    .lx-footer__social + .lx-footer__top {
      margin-left: 22px;
    }

    .lx-footer__social + .lx-footer__top::before {
      content: '';
      position: absolute;
      left: -22px;
      top: 50%;
      width: 1px;
      height: 44px;
      background: var(--lx-footer-line);
      transform: translateY(-50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lust Xstore footer",
  "tag": "div",
  "class": "section-lx-footer",
  "max_blocks": 16,
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Defaults to the Lust Xstore logo." },
    { "type": "text", "id": "logo_tagline", "label": "Logo tagline", "default": "Your wellness partner" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Thoughtfully designed wellness experiences inspired by nature, guided by science and created for everyday life."
    },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn" },
    { "type": "url", "id": "x_url", "label": "X" },
    { "type": "header", "content": "Trust row" },
    {
      "type": "checkbox",
      "id": "show_trust_row",
      "label": "Show trust row",
      "info": "Trust badges, licence box and quote.",
      "default": false
    },
    {
      "type": "richtext",
      "id": "licence_text",
      "label": "Licence box",
      "default": "<p><strong>FSSAI</strong><br>FSSAI LICENCE NUMBER:<br>(To Be Updated)</p>"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "“Crafted with Care. Guided by Purpose. Inspired by Your Wellness Journey.”"
    },
    { "type": "header", "content": "Bottom bar" },
    {
      "type": "richtext",
      "id": "copyright",
      "label": "Copyright",
      "default": "<p>© 2026 BODY अर्क™<br>Marketed by Lust Xstore Pvt. Ltd.<br>All Rights Reserved.</p>"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Because Wellness Isn't A Destination.\nIt's A Way Of Living."
    },
    { "type": "checkbox", "id": "show_back_to_top", "label": "Show back to top button", "default": true },
    { "type": "header", "content": "Style" },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Leave empty to use the default burgundy leaf background."
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#24070f" },
    { "type": "color", "id": "bottom_background_color", "label": "Bottom bar background", "default": "#1d050c" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#e07084" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Optional. When set, its links replace the manual links below."
        },
        { "type": "text", "id": "label_1", "label": "Link 1 label" },
        { "type": "url", "id": "url_1", "label": "Link 1 URL" },
        { "type": "text", "id": "label_2", "label": "Link 2 label" },
        { "type": "url", "id": "url_2", "label": "Link 2 URL" },
        { "type": "text", "id": "label_3", "label": "Link 3 label" },
        { "type": "url", "id": "url_3", "label": "Link 3 URL" },
        { "type": "text", "id": "label_4", "label": "Link 4 label" },
        { "type": "url", "id": "url_4", "label": "Link 4 URL" },
        { "type": "text", "id": "label_5", "label": "Link 5 label" },
        { "type": "url", "id": "url_5", "label": "Link 5 URL" },
        { "type": "text", "id": "label_6", "label": "Link 6 label" },
        { "type": "url", "id": "url_6", "label": "Link 6 URL" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Support & Contact" },
        { "type": "text", "id": "support_label", "label": "Support label", "default": "Customer Support" },
        { "type": "text", "id": "support_email", "label": "Support email", "default": "support@bodyark.in" },
        { "type": "text", "id": "business_label", "label": "Business label", "default": "Business Enquiries" },
