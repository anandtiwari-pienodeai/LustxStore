{%- comment -%}
  Lust Xstore — "What's inside your kit" viewer and items.
  Split from the homepage; styles live in assets/lx-home.css.
{%- endcomment -%}

<section class="lx-h lx-kit" style="--lx-pad-top: {{ section.settings.padding_top }}px; --lx-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="lx-h__wrap">
    {%- comment -%} ---------- What's inside ---------- {%- endcomment -%}
    <h3 class="lx-kit__subhead"><span aria-hidden="true">✦</span> {{ section.settings.inside_heading | escape }}</h3>

    <lx-kit-viewer class="lx-kit__inside">
      <div class="lx-kit__viewer" aria-hidden="true">
        <span class="lx-kit__viewer-tag">{{ section.settings.viewer_label | escape }}</span>
        {% assign idx = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'item' %}
            {% liquid
              if block.settings.image != blank
                assign img = block.settings.image | image_url: width: 900
              else
                assign img = block.settings.fallback_file | file_url | append: '&width=900'
              endif
            %}
            <img class="lx-kit__viewer-img{% if idx == 0 %} is-active{% endif %}" data-step="{{ idx }}" src="{{ img }}" srcset="{{ img | replace: '&width=900', '&width=480' }} 480w, {{ img }} 900w" sizes="(min-width: 990px) 560px, 90vw" alt="" width="900" height="700" loading="lazy">
            {% assign idx = idx | plus: 1 %}
          {% endif %}
        {% endfor %}
        <span class="lx-kit__viewer-dots">
          {% for i in (1..idx) %}<i data-step="{{ forloop.index0 }}"{% if forloop.first %} class="is-active"{% endif %}></i>{% endfor %}
        </span>
      </div>

      <ol class="lx-kit__items" role="list">
        {% assign idx = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'item' %}
            {% assign k = block.settings %}
            <li style="--item-color: {{ k.color }}; --item-tint: {{ k.tint }};" {{ block.shopify_attributes }}>
              <button type="button" class="lx-kit__item{% if idx == 0 %} is-active{% endif %}" data-step="{{ idx }}" aria-expanded="{% if idx == 0 %}true{% else %}false{% endif %}">
                <span class="lx-kit__item-icon">{% render 'lx-icon', icon: k.icon, size: 20 %}</span>
                <span class="lx-kit__item-head">
                  <small>{{ idx | plus: 1 | prepend: '0' | slice: -2, 2 }}</small>
                  <strong>{{ k.title | escape }}</strong>
                </span>
                <span class="lx-kit__item-chev" aria-hidden="true">›</span>
                <span class="lx-kit__item-desc">{{ k.text | escape }}</span>
              </button>
            </li>
            {% assign idx = idx | plus: 1 %}
          {% endif %}
        {% endfor %}
      </ol>
    </lx-kit-viewer>
  </div>
</section>

<script>
  if (!customElements.get('lx-kit-viewer')) {
    customElements.define(
      'lx-kit-viewer',
      class extends HTMLElement {
        connectedCallback() {
          this.row = this.querySelector('.lx-kit__items');
          this.cards = [...this.querySelectorAll('.lx-kit__item')];
          this.current = Math.max(0, this.cards.findIndex((b) => b.classList.contains('is-active')));
          this.cards.forEach((btn) => {
            btn.addEventListener('click', () => {
              this.select(Number(btn.dataset.step));
              this.reveal(Number(btn.dataset.step));
            });
            if (matchMedia('(hover: hover)').matches) {
              btn.addEventListener('mouseenter', () => this.select(Number(btn.dataset.step)));
            }
          });
          // Image dots double as controls
          this.querySelectorAll('.lx-kit__dots [data-step], .lx-kit__viewer-dots [data-step]').forEach((dot) =>
            dot.addEventListener('click', () => {
              this.select(Number(dot.dataset.step));
              this.reveal(Number(dot.dataset.step));
            })
          );
          // Phones: the card row scrolls sideways — the card at the front drives the image above
          this.row?.addEventListener('scroll', () => {
            if (this.programmatic) return;
            cancelAnimationFrame(this.raf);
            this.raf = requestAnimationFrame(() => this.syncFromScroll());
          }, { passive: true });
          this.row?.addEventListener('scrollend', () => { this.programmatic = false; this.syncFromScroll(); });
        }

        get scrollable() {
          return this.row && this.row.scrollWidth > this.row.clientWidth + 1;
        }

        syncFromScroll() {
          if (!this.scrollable) return;
          const rowBox = this.row.getBoundingClientRect();
          const pad = parseFloat(getComputedStyle(this.row).scrollPaddingInlineStart) || 0;
          const anchor = rowBox.left + pad;
          // At the far end the last card can't reach the front, so pick it once the row is fully scrolled
          const atEnd = this.row.scrollLeft + this.row.clientWidth >= this.row.scrollWidth - 2;
          let best = atEnd ? this.cards.length - 1 : 0;
          if (!atEnd) {
            let bestDist = Infinity;
            this.cards.forEach((card, i) => {
              const d = Math.abs(card.getBoundingClientRect().left - anchor);
              if (d < bestDist) { bestDist = d; best = i; }
            });
          }
          if (best !== this.current) this.select(best);
        }

        // Slide a card to the front of the row (row only — the page never scrolls)
        reveal(step) {
          if (!this.scrollable) return;
          const card = this.cards[step];
          if (!card) return;
          const pad = parseFloat(getComputedStyle(this.row).scrollPaddingInlineStart) || 0;
          const left = this.row.scrollLeft + card.getBoundingClientRect().left - this.row.getBoundingClientRect().left - pad;
          this.programmatic = true;
          clearTimeout(this.progTimer);
          this.progTimer = setTimeout(() => (this.programmatic = false), 700);
          this.row.scrollTo({ left, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        }

        select(step) {
          this.current = step;
          this.querySelectorAll('[data-step]').forEach((el) =>
            el.classList.toggle('is-active', Number(el.dataset.step) === step)
          );
          this.querySelectorAll('.lx-kit__item').forEach((btn) =>
            btn.setAttribute('aria-expanded', String(Number(btn.dataset.step) === step))
          );
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "What's inside",
  "tag": "div",
  "class": "section-lx-kit-inside",
  "settings": [
    {
      "type": "text",
      "id": "inside_heading",
      "label": "Heading",
      "default": "What's Inside Your Wellness Kit?"
    },
    {
      "type": "text",
      "id": "viewer_label",
      "label": "Viewer label",
      "default": "Unbox your kit"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Kit item",
      "limit": 10,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "kit_kitbox",
              "label": "Kit box"
            },
            {
              "value": "kit_morning",
              "label": "Morning"
            },
            {
              "value": "kit_afternoon",
              "label": "Afternoon"
            },
            {
              "value": "kit_evening",
              "label": "Evening"
            },
            {
              "value": "kit_formula",
              "label": "Formula"
            },
            {
              "value": "kit_hub",
              "label": "Hub"
            },
            {
              "value": "kit_guide",
              "label": "Guide"
            }
          ],
          "default": "kit_kitbox"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Magnetic Wellness Kit"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_file",
          "label": "Fallback image file (advanced)",
          "default": "ba-kit-box.png"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Colour",
          "default": "#b02d5c"
        },
        {
          "type": "color",
          "id": "tint",
          "label": "Icon background",
          "default": "#fbe0e8"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What's inside"
    }
  ]
}
{% endschema %}
