{%- comment -%}
  Lust Xstore — "Our Program" page.
  Hero → Morning · Afternoon · Evening ritual cards → 45-day transformation band → CTA band.
  Blocks: "Hero feature", "Ritual", "Benefit", "CTA feature". Images fall back to the
  BODY अर्क product shots in Settings → Files when no image is picked.
{%- endcomment -%}

{% liquid
  if section.settings.hero_image != blank
    assign hero_img = section.settings.hero_image
  else
    assign hero_img = articles['everyday_wellness/5-small-daily-habits'].image
  endif
%}

{% if section.settings.hero_script != blank %}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" media="print" onload="this.media='all'">
{% endif %}

<div class="lx-prog">
  {%- comment -%} ---------- Hero ---------- {%- endcomment -%}
  <section class="lx-prog-hero" aria-labelledby="LxProgTitle">
    {% if hero_img %}
      <div class="lx-prog-hero__media">
        {{
          hero_img
          | image_url: width: 1800
          | image_tag:
            widths: '700, 1000, 1400, 1800',
            sizes: '(min-width: 990px) 60vw, 100vw',
            fetchpriority: 'high',
            alt: ''
        }}
      </div>
    {% endif %}
    {% if section.settings.hero_script != blank %}
      <p class="lx-prog-hero__script" aria-hidden="true">{{ section.settings.hero_script | escape | newline_to_br }}</p>
    {% endif %}
    <div class="lx-prog__wrap lx-prog-hero__inner">
      <nav class="lx-prog-crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{{ page.title | default: section.settings.hero_title | escape }}</span>
      </nav>
      {% if section.settings.hero_eyebrow != blank %}
        <p class="lx-prog__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
      {% endif %}
      <h1 id="LxProgTitle" class="lx-prog-hero__title">{{ section.settings.hero_title | escape }}</h1>
      {% if section.settings.hero_text != blank %}
        <p class="lx-prog-hero__text">{{ section.settings.hero_text | escape }}</p>
      {% endif %}
      <ul class="lx-prog-hero__features" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'hero_feature' %}
            <li {{ block.shopify_attributes }}>
              <span class="lx-prog__icon-ring">{% render 'lx-program-icon', icon: block.settings.icon, size: 24 %}</span>
              <span>{{ block.settings.label | escape | newline_to_br }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </section>

  {%- comment -%} ---------- Rituals ---------- {%- endcomment -%}
  <section class="lx-prog-rituals" aria-labelledby="LxProgRitualsTitle">
    <div class="lx-prog__wrap">
      <header class="lx-prog-rituals__head">
        {% if section.settings.rituals_eyebrow != blank %}
          <p class="lx-prog__eyebrow">{{ section.settings.rituals_eyebrow | escape }}</p>
        {% endif %}
        <h2 id="LxProgRitualsTitle" class="lx-prog-rituals__title">
          <svg class="lx-prog-sprig" viewBox="0 0 64 48" aria-hidden="true"><path d="M60 40C44 38 30 30 20 12M30 30c-6-1-11-4-14-9 6-1 11 2 14 9zM40 36c-5 1-11-1-15-5 6-2 11 0 15 5zM24 22c-2-5-1-10 2-14 3 5 2 10-2 14zM34 30c0-6 3-10 8-12 1 6-3 10-8 12z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          <span>{{ section.settings.rituals_title | escape }}</span>
          <svg class="lx-prog-sprig lx-prog-sprig--flip" viewBox="0 0 64 48" aria-hidden="true"><path d="M60 40C44 38 30 30 20 12M30 30c-6-1-11-4-14-9 6-1 11 2 14 9zM40 36c-5 1-11-1-15-5 6-2 11 0 15 5zM24 22c-2-5-1-10 2-14 3 5 2 10-2 14zM34 30c0-6 3-10 8-12 1 6-3 10-8 12z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </h2>
        {% if section.settings.rituals_text != blank %}
          <p class="lx-prog-rituals__text">{{ section.settings.rituals_text | escape }}</p>
        {% endif %}
      </header>

      <ul class="lx-prog-rituals__grid" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'ritual' %}
            {% liquid
              assign r = block.settings
              if r.image != blank
                assign ritual_img = r.image | image_url: width: 700
              elsif r.fallback_file != blank
                assign ritual_img = r.fallback_file | file_url | append: '&width=700'
              else
                assign ritual_img = blank
              endif
            %}
            <li class="lx-ritual" style="--lx-ritual-tint: {{ r.tint }}; --lx-ritual-accent: {{ r.accent }};" {{ block.shopify_attributes }}>
              <div class="lx-ritual__body">
                <span class="lx-ritual__icon">{% render 'lx-program-icon', icon: r.icon, size: 28 %}</span>
                <h3 class="lx-ritual__title">{{ r.title | escape }}</h3>
                <p class="lx-ritual__sub">{{ r.subtitle | escape }}</p>
                <p class="lx-ritual__text">{{ r.text | escape }}</p>
                <ul class="lx-ritual__points" role="list">
                  {% for n in (1..3) %}
                    {% assign key = 'point_' | append: n %}
                    {% if r[key] != blank %}
                      <li>{{ r[key] | escape }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
              {% if ritual_img != blank %}
                <img class="lx-ritual__img" src="{{ ritual_img }}" alt="{{ r.title | escape }} pouch" width="400" height="600" loading="lazy">
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      {%- comment -%} ---------- 45-day transformation ---------- {%- endcomment -%}
      <section class="lx-prog-transform" aria-labelledby="LxProgTransformTitle">
        <img class="lx-prog-transform__leaf" src="{{ 'lx-footer-leaf.png' | asset_url }}" alt="" width="259" height="332" loading="lazy" aria-hidden="true">
        <div class="lx-prog-transform__intro">
          <h2 id="LxProgTransformTitle">{{ section.settings.transform_title | escape }}</h2>
          <p>{{ section.settings.transform_text | escape }}</p>
        </div>
        <ul class="lx-prog-transform__list" role="list">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <li {{ block.shopify_attributes }}>
                <span class="lx-prog__icon-ring lx-prog__icon-ring--lg">{% render 'lx-program-icon', icon: block.settings.icon, size: 28 %}</span>
                <span>{{ block.settings.label | escape | newline_to_br }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </section>

      {%- comment -%} ---------- CTA ---------- {%- endcomment -%}
      {% liquid
        if section.settings.cta_image != blank
          assign cta_img = section.settings.cta_image | image_url: width: 900
        else
          assign cta_img = 'lx-guides-kit-fan.png' | file_url | append: '&width=900'
        endif
      %}
      <section class="lx-prog-cta" style="--lx-cta-bg: url('{{ 'lx-footer-bg.webp' | asset_url }}');" aria-labelledby="LxProgCtaTitle">
        <div class="lx-prog-cta__copy">
          {% if section.settings.cta_eyebrow != blank %}
            <p class="lx-prog__eyebrow lx-prog__eyebrow--light">{{ section.settings.cta_eyebrow | escape }}</p>
          {% endif %}
          <h2 id="LxProgCtaTitle">{{ section.settings.cta_title | escape | newline_to_br }}</h2>
          {% if section.settings.cta_text != blank %}
            <p class="lx-prog-cta__text">{{ section.settings.cta_text | escape }}</p>
          {% endif %}
          {% if section.settings.cta_label != blank %}
            <a class="lx-prog-cta__btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
              {{ section.settings.cta_label | escape }} <span aria-hidden="true">&rarr;</span>
            </a>
          {% endif %}
        </div>
        <img class="lx-prog-cta__img" src="{{ cta_img }}" alt="BODY अर्क Women daily pouches" width="900" height="468" loading="lazy">
        <ul class="lx-prog-cta__features" role="list">
          {% for block in section.blocks %}
            {% if block.type == 'cta_feature' %}
              <li {{ block.shopify_attributes }}>
                {% render 'lx-program-icon', icon: block.settings.icon, size: 30 %}
                <span>{{ block.settings.label | escape | newline_to_br }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </section>
    </div>
  </section>
</div>

{% stylesheet %}
  .lx-prog {
    --lx-prog-ink: #2b2226;
    --lx-prog-muted: #5e5256;
    --lx-prog-rose: #a8454f;
    --lx-prog-cream: #fbf6f2;

    background: var(--lx-prog-cream);
    color: var(--lx-prog-ink);
  }

  .lx-prog__wrap {
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  @media screen and (min-width: 750px) {
    .lx-prog__wrap {
      padding-inline: 32px;
    }
  }

  .lx-prog__eyebrow {
    margin: 0 0 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lx-prog-rose);
  }

  .lx-prog__eyebrow--light {
    color: #f1c9c2;
  }

  .lx-prog__icon-ring {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: #f6dfd6;
    color: var(--lx-prog-rose);
  }

  .lx-prog__icon-ring--lg {
    width: 56px;
    height: 56px;
  }

  /* ---------- Hero ---------- */
  .lx-prog-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(90deg, #fbeee7 0%, #fbeee7 38%, #f6e3d6 100%);
  }

  .lx-prog-hero__media {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  .lx-prog-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .lx-prog-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, #fbeee7 0%, rgb(251 238 231 / 0) 40%);
  }

  .lx-prog-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 0 36px;
    margin-top: -40px;
  }

  .lx-prog-hero__script {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .lx-prog-hero {
      min-height: 460px;
      display: flex;
      align-items: center;
    }

    .lx-prog-hero__media {
      position: absolute;
      inset: 0 0 0 auto;
      width: 62%;
      aspect-ratio: auto;
    }

    .lx-prog-hero__media::after {
      background: linear-gradient(90deg, #fbeee7 0%, rgb(251 238 231 / 0.6) 22%, rgb(251 238 231 / 0) 50%);
    }

    .lx-prog-hero__inner {
      margin-top: 0;
      padding-block: 20px 48px;
    }

    .lx-prog-hero__inner > * {
      max-width: 560px;
    }

    .lx-prog-hero__inner > .lx-prog-hero__features {
      max-width: 700px;
      flex-wrap: nowrap;
      gap: 20px;
    }

    .lx-prog-hero__script {
      position: absolute;
      top: 12%;
      right: 4%;
      z-index: 1;
      display: block;
      margin: 0;
      font-family: 'Caveat', 'Segoe Script', cursive !important;
      font-size: clamp(2rem, 3vw, 2.75rem);
      line-height: 1;
      color: #a8454f;
      transform: rotate(-12deg);
    }
  }

  .lx-prog-crumbs {
    display: flex;
    gap: 8px;
    margin-bottom: clamp(18px, 3vw, 36px);
    font-size: 0.8125rem;
    color: var(--lx-prog-muted);
  }

  .lx-prog-crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .lx-prog-hero__title {
    margin: 0 0 14px;
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    line-height: 1;
    color: var(--lx-prog-ink);
  }

  .lx-prog-hero__text {
    margin: 0 0 28px;
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    line-height: 1.5;
    color: #3d3236;
  }

  .lx-prog-hero__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .lx-prog-hero__features {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
    }
  }

  .lx-prog-hero__features li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.875rem;
    line-height: 1.35;
  }

  /* ---------- Rituals ---------- */
  .lx-prog-rituals {
    padding-block: clamp(36px, 5vw, 56px) clamp(40px, 5vw, 64px);
  }

  .lx-prog-rituals__head {
    margin-bottom: 28px;
    text-align: center;
  }

  .lx-prog-rituals__title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin: 0 0 10px;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1.15;
  }

  .lx-prog-sprig {
    display: none;
    width: 64px;
    height: 48px;
    color: #c98f86;
  }

  .lx-prog-sprig--flip {
    transform: scaleX(-1);
  }

  @media screen and (min-width: 750px) {
    .lx-prog-sprig {
      display: block;
    }
  }

  .lx-prog-rituals__text {
    margin: 0;
    color: var(--lx-prog-muted);
  }

  .lx-prog-rituals__grid {
    display: grid;
    gap: 16px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 990px) {
    .lx-prog-rituals__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lx-ritual {
    position: relative;
    display: flex;
    min-height: 290px;
    overflow: hidden;
    border-radius: 18px;
    background: linear-gradient(135deg, #fff 0%, var(--lx-ritual-tint) 100%);
    box-shadow: 0 14px 30px -24px rgb(43 34 38 / 0.5);
  }

  .lx-ritual__body {
    position: relative;
    z-index: 1;
    max-width: 58%;
    padding: 22px 0 22px 22px;
  }

  .lx-ritual__icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    margin-bottom: 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    color: var(--lx-ritual-accent);
  }

  .lx-ritual__title {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .lx-ritual__sub {
    margin: 4px 0 12px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lx-ritual-accent);
  }

  .lx-ritual__text {
    margin: 0 0 14px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--lx-prog-muted);
  }

  .lx-ritual__points {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
  }

  .lx-ritual__points li {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .lx-ritual__points li::before {
    content: '';
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    border: 1.4px solid var(--lx-ritual-accent);
  }

  .lx-ritual__points li {
    position: relative;
  }

  .lx-ritual__points li::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 50%;
    width: 4px;
    height: 7px;
    border-right: 1.4px solid var(--lx-ritual-accent);
    border-bottom: 1.4px solid var(--lx-ritual-accent);
    transform: translateY(-65%) rotate(45deg);
  }

  .lx-ritual__img {
    position: absolute;
    right: -7%;
    bottom: -4%;
    width: 44%;
    height: auto;
    filter: drop-shadow(0 16px 18px rgb(43 34 38 / 0.22));
    transform: rotate(4deg);
    transition: transform 0.4s ease;
  }

  @media (hover: hover) {
    .lx-ritual:hover .lx-ritual__img {
      transform: rotate(2deg) translateY(-6px);
    }
  }

  /* ---------- Transformation ---------- */
  .lx-prog-transform {
    position: relative;
    display: grid;
    gap: 24px;
    margin-bottom: 16px;
    padding: 28px 22px;
    overflow: hidden;
    border-radius: 18px;
    background: linear-gradient(110deg, #f9e3df 0%, #fbeeea 60%, #f6dcd4 100%);
  }

  .lx-prog-transform__leaf {
    position: absolute;
    right: 0;
    bottom: 0;
    height: 120%;
    width: auto;
    opacity: 0.5;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 35%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 35%);
  }

  .lx-prog-transform__intro,
  .lx-prog-transform__list {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 989px) {
    .lx-prog-transform__leaf {
      height: 60%;
      opacity: 0.25;
    }
  }

  .lx-prog-transform__intro h2 {
    margin: 0 0 8px;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .lx-prog-transform__intro p {
    margin: 0;
    color: var(--lx-prog-muted);
  }

  .lx-prog-transform__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lx-prog-transform__list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.3;
  }

  @media screen and (min-width: 990px) {
    .lx-prog-transform {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
      align-items: center;
      padding: 32px 220px 32px 44px;
    }

    .lx-prog-transform__intro {
      padding-right: 36px;
      border-right: 1px solid rgb(168 69 79 / 0.2);
    }

    .lx-prog-transform__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* ---------- CTA ---------- */
  .lx-prog-cta {
    position: relative;
    display: grid;
    gap: 24px;
    padding: 32px 24px;
    overflow: hidden;
    border-radius: 18px;
    background: #2a0a14 var(--lx-cta-bg) center / cover no-repeat;
    color: #fff;
  }

  .lx-prog-cta__copy h2 {
    margin: 0 0 8px;
    font-size: clamp(1.75rem, 3vw, 2.375rem);
    line-height: 1.12;
    color: #fff;
  }

  .lx-prog-cta__text {
    margin: 0 0 22px;
    font-size: 1.0625rem;
    color: #f4e3e6;
  }

  .lx-prog-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 999px;
    background: #c96d78;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 12px 26px -12px rgb(201 109 120 / 0.9);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .lx-prog-cta__btn:hover {
    background: #d67c86;
    transform: translateY(-2px);
  }

  .lx-prog-cta__img {
    width: 100%;
    max-width: 460px;
    height: auto;
    justify-self: center;
    filter: drop-shadow(0 20px 24px rgb(0 0 0 / 0.45));
  }

  .lx-prog-cta__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lx-prog-cta__features li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: #f4e3e6;
  }

  .lx-prog-cta__features svg {
    color: #f0a6ad;
  }

  @media screen and (min-width: 990px) {
    .lx-prog-cta {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 0.8fr);
      align-items: center;
      gap: 32px;
      padding: 28px 44px 28px 96px;
    }

    .lx-prog-cta__img {
      max-width: none;
      margin-block: -8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Program",
  "tag": "div",
  "class": "section-lx-program",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "A structured wellness system" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "Our Program" },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Text",
      "default": "A simple, science-backed 45-Day wellness system designed for your everyday life."
    },
    { "type": "image_picker", "id": "hero_image", "label": "Image", "info": "Defaults to the \"5 Small Daily Habits\" article photo." },
    { "type": "textarea", "id": "hero_script", "label": "Handwritten note", "default": "Small Rituals\nBrighter Days" },
    { "type": "header", "content": "Rituals" },
    { "type": "text", "id": "rituals_eyebrow", "label": "Eyebrow", "default": "India's first structured wellness system" },
    { "type": "text", "id": "rituals_title", "label": "Title", "default": "Morning • Afternoon • Evening" },
    {
      "type": "text",
      "id": "rituals_text",
      "label": "Text",
      "default": "A complete daily routine with purpose — to help you feel better, look better and live better."
    },
    { "type": "header", "content": "45-day transformation" },
    { "type": "text", "id": "transform_title", "label": "Title", "default": "Your 45-Day Transformation" },
    {
      "type": "textarea",
