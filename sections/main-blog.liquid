<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<blog-posts-list section-id="{{ section.id }}">
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {% if section.settings.show_topics %}
      <nav class="blog-topics" aria-label="Blog topics">
        {% for b in blogs %}
          {% if b.articles_count > 0 or b.handle == blog.handle %}
            <a
              class="blog-topics__pill{% if b.handle == blog.handle %} is-active{% endif %}"
              href="{{ b.url }}"
              {% if b.handle == blog.handle %}
                aria-current="page"
              {% endif %}
            >
              {{- b.title -}}
            </a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    <div
      ref="grid"
      class="blog-posts-container"
    >
      {% liquid
        assign items_on_page = blog.articles.size
      %}
      {% for article in blog.articles %}
        {% liquid
          assign col_span = 2
          assign is_horizontal = false

          if items_on_page == 1
            assign col_span = 6
            assign is_horizontal = true
          elsif items_on_page == 2
            assign col_span = 3
          elsif forloop.first
            assign col_span = 6
            assign is_horizontal = true
          endif
        %}
        {% style %}
          [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
            --col-span: {{ col_span }};
            --blog-post-card-scale: 1;
          }

          @media screen and (max-width: 989px) {
            [data-blog-index="{{ section.id }}-{{ forloop.index }}"]:not(.blog-post-item--horizontal) {
              --col-span: 3;
            }
          }

          @media screen and (max-width: 749px) {
            [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
              --col-span: 6;
              --blog-post-card-scale: 1;
            }
          }
        {% endstyle %}
        <div
          class="blog-post-item{% if is_horizontal %} blog-post-item--horizontal{% endif %}"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ forloop.index }}"
        >
          {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
        </div>
      {% endfor %}
    </div>
  </div>
</blog-posts-list>

{% stylesheet %}
  /**
   * Blog listing page layout (modern editorial grid)
   */
  .blog-posts {
    --page-content-width: var(--wide-page-width, 1280px);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 32px;
    --rows-gap: 56px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
    align-items: start;
  }

  .blog-post-item {
    grid-column: span var(--col-span);
    background: transparent;
    border: 0;
    padding: 0;
    min-width: 0;
  }

  /* Featured (hero) post */
  .blog-post-item--horizontal {
    padding-block-end: 24px;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  /* Topic pills */
  .blog-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block: 0 40px;
  }

  .blog-topics__pill {
    display: inline-flex;
    align-items: center;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    font-size: 0.875rem;
    line-height: 1;
    text-decoration: none;
    color: var(--color-foreground);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .blog-topics__pill:hover {
    border-color: var(--color-foreground);
  }

  .blog-topics__pill.is-active {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  @media screen and (max-width: 749px) {
    .blog-posts {
      --rows-gap: 40px;
    }

    .blog-topics {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--page-margin) * -1);
      padding-inline: var(--page-margin);
    }

    .blog-topics::-webkit-scrollbar {
      display: none;
    }

    .blog-topics__pill {
      white-space: nowrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_topics",
      "label": "Show blog topic pills",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
