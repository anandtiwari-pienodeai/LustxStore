{%- liquid
  assign product = section.settings.product | default: closest.product | default: product
  assign v = product.selected_or_first_available_variant

  assign heading = section.settings.heading_override | default: product.title

  assign eyebrow = section.settings.eyebrow

  assign description = section.settings.description
  if section.settings.use_product_description and product.description != blank
    assign description = product.description
  endif

  assign has_plans = false
  if v.selling_plan_allocations.size > 0
    assign has_plans = true
    assign plan_alloc = v.selling_plan_allocations.first
    assign plan_save = v.price | minus: plan_alloc.per_delivery_price | times: 100.0 | divided_by: v.price | round
  endif

  assign show_variant_picker = false
  if product.has_only_default_variant == false and product.variants.size > 1
    assign show_variant_picker = true
  endif
-%}

{%- capture arka_variants_json -%}
[
{%- for variant in product.variants -%}
  {%- assign vp = variant.selling_plan_allocations.first -%}
  {
    "id": {{ variant.id | json }},
    "title": {{ variant.title | json }},
    "available": {{ variant.available }},
    "price": {{ variant.price | money | json }},
    "price_amount": {{ variant.price | json }},
    "compare": {{ variant.compare_at_price | money | json }},
    "compare_amount": {{ variant.compare_at_price | default: 0 | json }},
    "plan": {%- if vp -%}{
      "id": {{ vp.selling_plan.id | json }},
      "price": {{ vp.per_delivery_price | money | json }},
      "price_amount": {{ vp.per_delivery_price | json }},
      "save_pct": {{ variant.price | minus: vp.per_delivery_price | times: 100.0 | divided_by: variant.price | round | json }}
    }{%- else -%}null{%- endif -%}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

<section
  class="arka-hero"
  id="arka-hero-{{ section.id }}"
  style="
    --arka-hero-bg: {{ section.settings.bg_color }};
    --pbs: {{ section.settings.padding_block_start }}px;
    --pbe: {{ section.settings.padding_block_end }}px;
  "
>
  <div class="arka-wrap">
    {%- if section.settings.show_brand_strip -%}
      <div class="arka-brandstrip">
        <span class="arka-brandstrip__logo">
          {{ section.settings.brand_name }}
          {%- if section.settings.brand_suffix != blank -%}
            <span class="arka-brandstrip__suffix">{{ section.settings.brand_suffix }}</span>
          {%- endif -%}
        </span>
        {%- if section.settings.brand_tagline != blank -%}
          <span class="arka-brandstrip__tag">{{ section.settings.brand_tagline }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="arka-hero__grid">
      {%- comment -%} ---------- MEDIA ---------- {%- endcomment -%}
      {%- assign main_img_id = 'arka-main-img-' | append: section.id -%}
      {%- assign main_alt = product.featured_media.alt | default: product.title | escape -%}
      <div class="arka-gallery">
        <div class="arka-gallery__main">
          {%- if product.featured_media -%}
            {{
              product.featured_media
              | image_url: width: 1400
              | image_tag:
                loading: 'eager',
                sizes: '(min-width: 900px) 44vw, 100vw',
                widths: '400, 600, 800, 1000, 1200, 1400',
                class: 'arka-gallery__img',
                id: main_img_id,
                alt: main_alt
            }}
          {%- else -%}
            <div class="arka-gallery__img arka-gallery__img--ph">{{ product.title }} — Product Shot</div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="arka-thumbs">
            {%- for media in product.media limit: 6 -%}
              <button
                type="button"
                class="arka-thumb{% if forloop.first %} is-active{% endif %}"
                data-full="{{ media | image_url: width: 1400 }}"
                data-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="View image {{ forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', sizes: '76px', widths: '76, 152, 228', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- DETAILS ---------- {%- endcomment -%}
      <div class="arka-details">
        {%- if eyebrow != blank -%}
          <p class="arka-eyebrow">{{ eyebrow }}</p>
        {%- endif -%}

        <h1 class="arka-title">{{ heading }}</h1>

        {%- if description != blank -%}
          <div class="arka-lede">{{ description }}</div>
        {%- endif -%}

        {%- assign pills = section.blocks | where: 'type', 'pill' -%}
        {%- if pills.size > 0 -%}
          <div class="arka-pills">
            {%- for block in pills -%}
              <span
                class="arka-pill"
                style="--pill-bg: {{ block.settings.bg }}; --pill-fg: {{ block.settings.accent }};"
                {{ block.shopify_attributes }}
              >{{ block.settings.name }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="arka-price" data-arka-price>
          <span class="arka-price__now" data-arka-now>{{ v.price | money }}</span>
          <s class="arka-price__was" data-arka-was {% unless v.compare_at_price > v.price %}hidden{% endunless %}>{{ v.compare_at_price | money }}</s>
          <span class="arka-price__save" data-arka-save {% unless v.compare_at_price > v.price %}hidden{% endunless %}>
            {%- if v.compare_at_price > v.price -%}Save {{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}%{%- endif -%}
          </span>
        </div>

        {%- if section.settings.price_note != blank -%}
          <p class="arka-pricenote">{{ section.settings.price_note }}</p>
        {%- endif -%}

        {%- assign form_id = 'arka-form-' | append: section.id -%}
        {%- form 'product', product, id: form_id, class: 'arka-form' -%}
          <input type="hidden" name="id" value="{{ v.id }}" data-arka-id>
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="selling_plan" value="" data-arka-plan disabled>

          {%- if show_variant_picker -%}
            <label class="arka-variant">
              <span class="arka-variant__label">{{ product.options.first }}</span>
              <select class="arka-variant__select" data-arka-variant-select>
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" {% if variant.id == v.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </label>
          {%- endif -%}

          {%- if has_plans -%}
            <div class="arka-buyopts" data-arka-buyopts>
              <button type="button" class="arka-buyopt" data-arka-opt="subscribe" aria-pressed="false">
                <span class="arka-buyopt__body">
                  <span class="arka-buyopt__title" data-arka-sub-title>Subscribe &amp; Save {{ plan_save }}%</span>
                  <span class="arka-buyopt__desc">{{ section.settings.subscribe_desc }}</span>
                </span>
                <span class="arka-buyopt__price" data-arka-sub-price>{{ plan_alloc.per_delivery_price | money }}</span>
              </button>
              <button type="button" class="arka-buyopt is-active" data-arka-opt="onetime" aria-pressed="true">
                <span class="arka-buyopt__body">
                  <span class="arka-buyopt__title">{{ section.settings.onetime_label }}</span>
                  <span class="arka-buyopt__desc">{{ section.settings.onetime_desc }}</span>
                </span>
                <span class="arka-buyopt__price" data-arka-base-price>{{ v.price | money }}</span>
              </button>
            </div>
          {%- endif -%}

          <button
            type="submit"
            name="add"
            class="arka-atc"
            data-arka-atc
            {% unless v.available %}disabled{% endunless %}
          >
            <span data-arka-atc-text>
              {%- if v.available -%}
                {{ section.settings.atc_text }} &mdash; {{ v.price | money }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
        {%- endform -%}

        {%- if section.settings.reassurance_text != blank -%}
          <p class="arka-reassure">{{ section.settings.reassurance_text }}</p>
        {%- endif -%}

        {%- assign trust = section.blocks | where: 'type', 'trust' -%}
        {%- if trust.size > 0 -%}
          <div class="arka-trust">
            {%- for block in trust -%}
              <div class="arka-trust__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-arka-variants="{{ section.id }}">{{ arka_variants_json }}</script>
</section>

{% stylesheet %}
  .arka-hero {
    background: var(--arka-hero-bg, var(--arka-bg));
    color: var(--arka-ink);
    font-family: var(--arka-font-body);
    padding-block: var(--pbs, 0) var(--pbe, 96px);
  }

  .arka-wrap {
    max-width: var(--arka-max, 1280px);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  .arka-brandstrip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 28px 0;
    border-bottom: 1px solid var(--arka-line);
  }

  .arka-brandstrip__logo {
    font-family: var(--arka-font-heading);
    font-weight: 700;
    font-size: 24px;
    color: var(--arka-brand);
    letter-spacing: 0.5px;
  }

  .arka-brandstrip__suffix {
    font-family: var(--arka-font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--arka-muted);
    letter-spacing: 2px;
    margin-left: 8px;
  }

  .arka-brandstrip__tag {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: var(--arka-muted);
    text-transform: uppercase;
  }

  .arka-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4.5vw, 3.5rem);
    padding-top: 48px;
    align-items: start;
  }

  /* gallery */
  .arka-gallery {
    position: sticky;
    top: 24px;
    min-width: 0;
  }

  .arka-gallery__main {
    border-radius: 4px;
    overflow: hidden;
    background: var(--arka-surface);
    aspect-ratio: 1 / 1;
  }

  .arka-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .arka-gallery__img--ph {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    color: var(--arka-heading);
    background: linear-gradient(135deg, #e9c9cf, #c9b4d8);
  }

  .arka-thumbs {
    display: flex;
    gap: 12px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .arka-thumb {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    padding: 0;
    cursor: pointer;
    background: var(--arka-surface);
    border: 2px solid transparent;
    transition: border-color 0.15s ease, opacity 0.15s ease;
  }

  .arka-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .arka-thumb:hover {
    opacity: 0.85;
  }

  .arka-thumb.is-active {
    border-color: var(--arka-accent);
  }

  /* details */
  .arka-details {
    min-width: 0;
  }

  .arka-eyebrow {
    margin: 0 0 10px;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--arka-eyebrow);
    font-weight: 600;
  }

  .arka-title {
    font-family: var(--arka-font-heading);
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.15;
    margin: 0 0 14px;
    font-weight: 600;
    color: var(--arka-heading);
  }

  .arka-lede {
    font-size: 16px;
    line-height: 1.6;
    color: var(--arka-muted);
    margin: 0 0 24px;
    max-width: 520px;
  }

  .arka-lede > :first-child { margin-top: 0; }
  .arka-lede > :last-child { margin-bottom: 0; }

  .arka-pills {
    display: flex;
    gap: 10px;
    margin-bottom: 28px;
  }

  .arka-pill {
    flex: 1;
    padding: 6px 10px;
    border-radius: 20px;
    background: var(--pill-bg, var(--arka-surface));
    color: var(--pill-fg, var(--arka-heading));
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    letter-spacing: 0.3px;
  }

  .arka-price {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .arka-price__now {
    font-family: var(--arka-font-heading);
    font-size: 32px;
    font-weight: 600;
    color: var(--arka-heading);
  }

  .arka-price__was {
    font-size: 16px;
    color: var(--arka-muted-3);
    text-decoration: line-through;
  }

  .arka-price__save {
    font-size: 13px;
    font-weight: 600;
    color: var(--arka-save-text);
    background: var(--arka-save-bg);
    padding: 3px 10px;
    border-radius: 20px;
  }

  .arka-pricenote {
    font-size: 13px;
    color: var(--arka-muted-2);
    margin: 0 0 24px;
  }

  .arka-form {
    margin: 0;
  }

  .arka-variant {
    display: block;
    margin-bottom: 20px;
  }

  .arka-variant__label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--arka-heading);
    margin-bottom: 6px;
  }

  .arka-variant__select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--arka-line);
    border-radius: 4px;
    background: var(--arka-surface-soft);
    color: var(--arka-heading);
    font: inherit;
  }

  .arka-buyopts {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
    border: 1px solid var(--arka-line);
    border-radius: 4px;
    padding: 6px;
  }

  .arka-buyopt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 3px;
    cursor: pointer;
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    font: inherit;
    color: inherit;
  }

  .arka-buyopt.is-active {
    background: color-mix(in oklab, var(--arka-accent) 8%, transparent);
    border-color: var(--arka-accent);
  }

  .arka-buyopt__body {
    min-width: 0;
  }

  .arka-buyopt__title {
    display: block;
    font-weight: 600;
    font-size: 14px;
    color: var(--arka-heading);
  }

  .arka-buyopt__desc {
    display: block;
    font-size: 12px;
    color: var(--arka-muted-2);
    margin-top: 2px;
  }

  .arka-buyopt__price {
    font-weight: 600;
    font-size: 15px;
    color: var(--arka-heading);
    flex-shrink: 0;
  }

  .arka-atc {
    width: 100%;
    padding: 17px 0;
    background: var(--arka-accent);
    color: var(--arka-on-accent);
    border: none;
    border-radius: 4px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.4px;
    cursor: pointer;
    margin-bottom: 14px;
    transition: background 0.15s ease;
  }

  .arka-atc:hover:not([disabled]) {
    background: var(--arka-accent-hover);
  }

  .arka-atc[disabled] {
    background: var(--arka-line);
    color: var(--arka-muted-2);
    cursor: not-allowed;
  }

  .arka-reassure {
    text-align: center;
    font-size: 12px;
    color: var(--arka-muted-2);
    margin: 0 0 28px;
  }

  .arka-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    border-top: 1px solid var(--arka-line);
    padding-top: 24px;
  }

  .arka-trust__item {
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--arka-heading);
  }

  .arka-trust__item:not(:first-child) {
    border-left: 1px solid var(--arka-line);
  }

  @media (max-width: 899px) {
    .arka-hero {
      padding-bottom: min(var(--pbe, 96px), 52px);
    }

    .arka-hero__grid {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 28px;
    }

    .arka-gallery {
      position: static;
    }

    .arka-gallery__main {
      aspect-ratio: 4 / 3;
    }

    .arka-title {
      font-size: clamp(26px, 7vw, 32px);
    }
  }

  @media (max-width: 560px) {
    .arka-brandstrip {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 18px 0;
    }

    .arka-pills {
      flex-wrap: wrap;
    }

    .arka-pill {
      flex: 1 0 calc(33.333% - 7px);
    }

    .arka-buyopt {
      padding: 12px 14px;
    }

    .arka-thumbs {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      margin-inline: -18px;
      padding-inline: 18px;
    }

    .arka-thumbs::-webkit-scrollbar {
      display: none;
    }

    .arka-thumb {
      width: 64px;
      height: 64px;
    }

    .arka-trust {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .arka-trust__item {
      text-align: left;
      padding: 12px 0;
    }

    .arka-trust__item:not(:first-child) {
      border-left: none;
      border-top: 1px solid var(--arka-line);
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.getElementById('arka-hero-{{ section.id }}');
    if (!root || root.dataset.arkaInit === '1') return;
    root.dataset.arkaInit = '1';

    var data = [];
    try { data = JSON.parse(root.querySelector('[data-arka-variants="{{ section.id }}"]').textContent); } catch (e) {}

    var idInput = root.querySelector('[data-arka-id]');
    var planInput = root.querySelector('[data-arka-plan]');
    var now = root.querySelector('[data-arka-now]');
    var was = root.querySelector('[data-arka-was]');
    var save = root.querySelector('[data-arka-save]');
    var atc = root.querySelector('[data-arka-atc]');
    var atcText = root.querySelector('[data-arka-atc-text]');
    var subPrice = root.querySelector('[data-arka-sub-price]');
    var subTitle = root.querySelector('[data-arka-sub-title]');
    var basePrice = root.querySelector('[data-arka-base-price]');
    var opts = root.querySelectorAll('[data-arka-opt]');
    var atcLabel = {{ section.settings.atc_text | json }};
    var soldOut = {{ 'products.product.sold_out' | t | json }};

    var state = { variant: data[0], mode: 'onetime' };
    var current = root.querySelector('[data-arka-variant-select]');
    if (current) {
      state.variant = data.filter(function (x) { return String(x.id) === String(current.value); })[0] || data[0];
    }

    function render() {
      var vr = state.variant;
      if (!vr) return;
      if (idInput) idInput.value = vr.id;

      var subscribed = state.mode === 'subscribe' && vr.plan;
      var shownAmount = subscribed ? vr.plan.price_amount : vr.price_amount;
      var shownLabel = subscribed ? vr.plan.price : vr.price;

      if (planInput) {
        if (subscribed) { planInput.value = vr.plan.id; planInput.disabled = false; }
        else { planInput.value = ''; planInput.disabled = true; }
      }

      if (now) now.textContent = shownLabel;

      var showCompare;
      if (subscribed) {
        showCompare = true;
        if (was) { was.textContent = vr.price; was.hidden = false; }
        if (save) { save.textContent = 'Save ' + vr.plan.save_pct + '%'; save.hidden = false; }
      } else {
        showCompare = vr.compare_amount && Number(vr.compare_amount) > Number(vr.price_amount);
        if (was) { was.textContent = showCompare ? vr.compare : ''; was.hidden = !showCompare; }
        if (save && !showCompare) { save.hidden = true; }
        if (save && showCompare) {
          var pct = Math.round((Number(vr.compare_amount) - Number(vr.price_amount)) * 100 / Number(vr.compare_amount));
          save.textContent = 'Save ' + pct + '%';
          save.hidden = false;
        }
      }

      if (subPrice && vr.plan) subPrice.textContent = vr.plan.price;
      if (subTitle && vr.plan) subTitle.innerHTML = 'Subscribe &amp; Save ' + vr.plan.save_pct + '%';
      if (basePrice) basePrice.textContent = vr.price;

      if (atc && atcText) {
        if (vr.available) {
          atc.removeAttribute('disabled');
          atcText.innerHTML = atcLabel + ' — ' + shownLabel;
        } else {
          atc.setAttribute('disabled', 'disabled');
          atcText.textContent = soldOut;
        }
      }
    }

    opts.forEach(function (btn) {
      btn.addEventListener('click', function () {
        state.mode = btn.dataset.arkaOpt;
        opts.forEach(function (b) {
          var on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        render();
      });
    });

    if (current) {
      current.addEventListener('change', function () {
        state.variant = data.filter(function (x) { return String(x.id) === String(current.value); })[0];
        render();
      });
    }

    var mainImg = document.getElementById('arka-main-img-{{ section.id }}');
    root.querySelectorAll('.arka-thumb').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!mainImg) return;
        root.querySelectorAll('.arka-thumb').forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        mainImg.removeAttribute('srcset');
        mainImg.src = btn.dataset.full;
        if (btn.dataset.alt) mainImg.alt = btn.dataset.alt;
      });
    });

    render();
  })();
</script>

{% schema %}
{
  "name": "Arka PDP — Hero",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
