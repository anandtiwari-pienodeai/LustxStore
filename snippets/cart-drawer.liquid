{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {%- liquid
    assign lx_shop_url = settings.empty_cart_button_link
    if lx_shop_url == blank or lx_shop_url == '/collections/all'
      assign lx_first_product = collections.all.products.first
      if lx_first_product
        assign lx_shop_url = lx_first_product.url
      else
        assign lx_shop_url = routes.all_products_collection_url
      endif
    endif
  -%}

  {% capture lx_cart_trust %}
    <ul class="lx-cd__trust" role="list">
      <li>
        <span class="lx-cd__trust-icon">{% render 'lx-icon', icon: 'leaf', size: 22, stroke: 1.5 %}</span>
        <span>{{ settings.lx_cart_trust_1 | default: 'Premium Wellness Products' }}</span>
      </li>
      <li>
        <span class="lx-cd__trust-icon">{% render 'lx-icon', icon: 'truck', size: 22, stroke: 1.5 %}</span>
        <span>{{ settings.lx_cart_trust_2 | default: 'Secure Checkout' }}</span>
      </li>
      <li>
        <span class="lx-cd__trust-icon">{% render 'lx-icon', icon: 'shield', size: 22, stroke: 1.5 %}</span>
        <span>{{ settings.lx_cart_trust_3 | default: 'Trusted by Thousands' }}</span>
      </li>
    </ul>
  {% endcapture %}

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content lx-cd__empty"
      aria-label="{{ 'accessibility.cart' | t }}"
      data-cart-drawer-empty
    >
      <svg class="lx-cd__empty-art" viewBox="0 0 260 210" aria-hidden="true">
        <ellipse cx="130" cy="186" rx="104" ry="16" fill="#f6e6de"/>
        <g fill="none" stroke="#a8664f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M82 26l14 16 M130 14v26 M178 26l-14 16" stroke="#c98a6c"/>
          <path d="M60 78l118-8 36 10-6 104-128 10z" fill="#fbeee8"/>
          <path d="M178 70l36 10 -6 104" fill="#f3ddd3"/>
          <path d="M60 78l-2 116" />
          <path d="M100 92c-2-30 6-44 16-44s18 14 16 42" />
          <circle cx="100" cy="92" r="3" fill="#a8664f"/>
          <circle cx="132" cy="90" r="3" fill="#a8664f"/>
        </g>
      </svg>

      <h2 class="lx-cd__empty-title" id="cart-drawer-heading">
        {%- if settings.lx_cart_empty_heading != blank -%}
          {{ settings.lx_cart_empty_heading }}
        {%- else -%}
          {{ 'content.your_cart_is_empty' | t }}
        {%- endif -%}
      </h2>
      {%- if settings.lx_cart_empty_text != blank -%}
        <p class="lx-cd__empty-text">{{ settings.lx_cart_empty_text }}</p>
      {%- endif -%}

      {%- if settings.lx_cart_empty_button != blank -%}
        <a class="lx-cd__empty-button" href="{{ lx_shop_url }}">
          {{ settings.lx_cart_empty_button }}
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}

      {{ lx_cart_trust }}

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <p class="lx-cd__login">{{ 'actions.log_in_html' | t: link: routes.account_login_url }}</p>
      {%- endif -%}
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-modal
    no-persist
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer lx-cd"
      aria-labelledby="lx-cart-title"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          <div class="theme-drawer__header lx-cd__header">
            <div class="lx-cd__heading">
              <h2 class="theme-drawer__title lx-cd__title" id="lx-cart-title">
                Your Cart
                {%- unless cart.empty? %}
                  <span class="lx-cd__count" aria-hidden="true">{{ cart.item_count }}</span>
                  <span class="visually-hidden">{{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}</span>
                {%- endunless %}
              </h2>
              {%- if settings.lx_cart_subtitle != blank and cart.empty? == false -%}
                <p class="lx-cd__sub">{{ settings.lx_cart_subtitle }}</p>
              {%- endif -%}
            </div>
            <button
              on:click="#cart-drawer/close"
              class="theme-drawer__close-button lx-cd__close"
              type="button"
              aria-label="{{ 'actions.close' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="--header-height: 60px;"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }
{% endstylesheet %}
