{%- doc -%}
  Renders a pill-styled call-to-action button in the header actions row.

  @param {string} label - The button text
  @param {string} [link] - The button link
{%- enddoc -%}

<a
  href="{{ link | default: '#' }}"
  class="header-cta-button"
>
  {{ label }}
  <svg class="header-cta-button__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>

{% stylesheet %}
  .header-cta-button {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    background-color: var(--header-cta-background, #C1707A);
    color: var(--header-cta-text, #FFFFFF);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
    border-radius: var(--style-border-radius-buttons, 999px);
    text-decoration: none;
    transition: opacity var(--duration-short) ease;
  }

  .header-cta-button:hover {
    opacity: 0.85;
    text-decoration: none;
    color: var(--header-cta-text, #FFFFFF);
  }

  /* Hidden until the full desktop menu shows; on tablets it collides with the logo */
  @media screen and (max-width: 989px) {
    .header-cta-button {
      display: none;
    }
  }
{% endstylesheet %}
