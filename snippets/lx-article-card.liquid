{%- doc -%}
  Small blog post card for the "Continue reading" row on the blog post page.

  @param {object} post - The article to show
  @param {string} [category] - Label shown above the title (usually the blog title)
{%- enddoc -%}
{% liquid
  assign words = post.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200.0 | ceil
  if minutes < 1
    assign minutes = 1
  endif
%}
<li class="lx-related-card">
  <a href="{{ post.url }}">
    <div class="lx-related-card__media">
      {% if post.image %}
        {{
          post.image
          | image_url: width: 700
          | image_tag:
            widths: '360, 520, 700',
            sizes: '(min-width: 990px) 280px, (min-width: 750px) 45vw, 72vw',
            loading: 'lazy',
            alt: post.image.alt | default: post.title
        }}
      {% endif %}
    </div>
    {% if category != blank %}
      <p class="lx-related-card__cat">{{ category | escape }}</p>
    {% endif %}
    <h3 class="lx-related-card__title">{{ post.title | escape }}</h3>
    <p class="lx-related-card__meta">{{ minutes }} min read</p>
  </a>
</li>
