{%- doc -%}
  Line icons for the Lust Xstore footer (trust badges and social links).

  @param {string} icon - star | leaf | lock | check | clipboard | pin | truck | heart | instagram | facebook | youtube | pinterest | linkedin | x
{%- enddoc -%}
{%- case icon -%}
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M5 19c0-8 5.5-13.5 15-14-.5 9.5-6 15-14 15M5 19l7-7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5M12 14.5v2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8.5 12.5l2.5 2.5 5-5.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'clipboard' -%}
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><rect x="5.5" y="5" width="13" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M9 5V3.5h6V5M8.5 10h7M8.5 13.5h7M8.5 17h4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'pin' -%}
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 21s6.5-5.8 6.5-11a6.5 6.5 0 0 0-13 0c0 5.2 6.5 11 6.5 11z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M3 6.5h11v10H3zM14 10h4l3 3.5v3h-7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="17.5" cy="17.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.3 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V9a.5.5 0 0 1 .5-.5z" fill="currentColor"/></svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 9.3v5.4l4.6-2.7z" fill="currentColor"/></svg>
  {%- when 'pinterest' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 0 0-3.1 16.4c-.1-.7-.1-1.8 0-2.6l1-4.3s-.3-.5-.3-1.3c0-1.2.7-2.1 1.6-2.1.8 0 1.1.6 1.1 1.2 0 .8-.5 1.9-.7 2.9-.2.9.4 1.6 1.3 1.6 1.5 0 2.7-1.6 2.7-4 0-2.1-1.5-3.5-3.6-3.5-2.5 0-3.9 1.8-3.9 3.8 0 .8.3 1.6.7 2l.1.3-.2 1c0 .2-.2.2-.4.1-1.2-.5-1.9-2.2-1.9-3.6 0-2.9 2.1-5.6 6.1-5.6 3.2 0 5.7 2.3 5.7 5.4 0 3.2-2 5.8-4.8 5.8-1 0-1.9-.5-2.2-1.1l-.6 2.3c-.2.8-.8 1.9-1.2 2.5A8.5 8.5 0 1 0 12 3.5z" fill="currentColor"/></svg>
  {%- when 'linkedin' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6.5 9.5V18M6.5 6v.01M10.5 18v-5a3 3 0 0 1 6 0v5M10.5 9.5V18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
  {%- when 'x' -%}
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
{%- endcase -%}
