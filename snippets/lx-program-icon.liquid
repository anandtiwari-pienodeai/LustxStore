{%- doc -%}
  Line icons for the Our Program page.

  @param {string} icon - leaf | lotus | atom | heart | sun | moon | mind | flask | shield | people | box | seedling | sprout
  @param {number} [size] - Pixel size (default 26)
{%- enddoc -%}
{%- assign s = size | default: 26 -%}
{%- case icon -%}
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M5 19c0-8 5.5-13.5 15-14-.5 9.5-6 15-14 15M5 19l7-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'lotus' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M12 18c-2.5-2-3.5-4.5-3.5-7S10 6 12 4.5C14 6 15.5 8.5 15.5 11s-1 5-3.5 7zM12 18c-3 .5-6.5-.5-8.5-3.5 2-.8 4.3-.7 6 .3M12 18c3 .5 6.5-.5 8.5-3.5-2-.8-4.3-.7-6 .3M6 19.5h12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'atom' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><ellipse cx="12" cy="12" rx="9" ry="3.6" fill="none" stroke="currentColor" stroke-width="1.4"/><ellipse cx="12" cy="12" rx="9" ry="3.6" transform="rotate(60 12 12)" fill="none" stroke="currentColor" stroke-width="1.4"/><ellipse cx="12" cy="12" rx="9" ry="3.6" transform="rotate(-60 12 12)" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.3 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  {%- when 'sun' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 2.5v2.3M12 19.2v2.3M2.5 12h2.3M19.2 12h2.3M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'moon' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  {%- when 'mind' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M13 21v-3h2.5a1.5 1.5 0 0 0 1.5-1.5V14l1.8-.7-1.6-3A7 7 0 1 0 7 15.5V21" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.5 10.5a2 2 0 0 1 2-2 2 2 0 0 1 2 2 2 2 0 0 1-2 2v1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'flask' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M9.5 3.5h5M10.5 3.5v6L5 19a1.5 1.5 0 0 0 1.3 2.2h11.4A1.5 1.5 0 0 0 19 19l-5.5-9.5v-6M7.5 15h9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M12 3l7 3v5.5c0 4.5-3 8-7 9.5-4-1.5-7-5-7-9.5V6z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 12l2 2 4-4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'people' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><circle cx="12" cy="7.5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="5.8" cy="9.5" r="2" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="18.2" cy="9.5" r="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M7.5 18.5a4.5 4.5 0 0 1 9 0M2.5 18a3.3 3.3 0 0 1 5-2.8M21.5 18a3.3 3.3 0 0 0-5-2.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'box' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z M4 7.5l8 4.5 8-4.5M12 12v9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
  {%- when 'seedling' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M12 20v-8M12 12c0-3.5 2.5-6 6.5-6.5C18 9.5 15.5 12 12 12zM12 14c0-3-2-5-5.5-5.5.5 3.5 2.5 5.5 5.5 5.5zM8 20h8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'sprout' -%}
    <svg viewBox="0 0 48 48" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M24 42V24M24 24c0-8 5-13 14-14-1 9-6 14-14 14zM24 28c0-6-4-10-11-11 1 7 5 11 11 11z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
{%- endcase -%}
