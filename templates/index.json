    "lx_faq": {
      "type": "lx-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "What is BODY अर्क WOMEN?",
            "answer": "<p>BODY अर्क WOMEN is a thoughtfully designed 45-Day Premium Wellness Kit that brings together five specialised wellness formulations within a simple, organised daily experience for modern women.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How is the wellness experience organised?",
            "answer": "<p>The kit is organised around three daily wellness moments — Morning, Afternoon and Evening — with clearly identified, individually packed tablets that make the routine simple and easy to follow.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What comes inside the BODY अर्क WOMEN Kit?",
            "answer": "<p>The Premium Magnetic Wellness Kit, organised daily wellness pouches, five specialised formulations, a Welcome Guide and access to the BODY अर्क Wellness Hub.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Why are the tablets individually packed?",
            "answer": "<p>Each tablet is individually packed to support product integrity, hygiene and convenience, while keeping your daily experience organised.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Where can I learn more about the ingredients?",
            "answer": "<p>Visit the BODY अर्क Wellness Hub to explore the Ingredient Library, our formulation philosophy and educational wellness resources.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Is customer support available?",
            "answer": "<p>Yes. Our Wellness Support Team is available to help with product guidance, general enquiries and your overall BODY अर्क experience.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "What happens after completing the first 45 days?",
            "answer": "<p>Your first 45 days establish the foundation. We recommend continuing with the Recommended 90-Day Wellness Journey to build lasting consistency.</p>"
          }
        },
        "q8": {
          "type": "question",
          "settings": {
            "question": "What is the BODY अर्क Confidence Promise?",
            "answer": "<p>Our commitment to quality, transparency and customer support. Eligible customers who complete the Recommended 90-Day Journey may qualify for the Satisfaction Commitment, subject to the Confidence Promise Policy and eligibility criteria.</p>"
          }
        },
