    "info_faq": {
      "type": "arka-info-faq",
      "blocks": {
        "n1": {
          "type": "safety_note",
          "settings": {
            "title": "Who it's for",
            "body": "<p>Formulated for adult women. If you are pregnant, nursing, taking medication or have a medical condition, consult your healthcare professional before use.</p>"
          }
        },
        "n2": {
          "type": "safety_note",
          "settings": {
            "title": "Sourcing",
            "body": "<p>Plant-based botanical formulas, rooted in Ayurvedic tradition and made in India.</p>"
          }
        },
        "n3": {
          "type": "safety_note",
          "settings": {
            "title": "Storage",
            "body": "<p>Store in a cool, dry place away from direct sunlight. Keep out of reach of children.</p>"
          }
        },
        "f1": {
          "type": "faq",
          "settings": {
            "question": "How long does one box last?",
            "answer": "<p>One box is a complete 45-day journey — one strip a day, with a Morning, Afternoon and Evening sachet on each strip.</p>",
            "open_by_default": true
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "question": "Do I need to take all three sachets every day?",
            "answer": "<p>Yes. Morning Balance, Afternoon Glow and Evening Restore work together as one complete daily ritual.</p>"
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "question": "Can I take it on an empty stomach?",
            "answer": "<p>Please follow the serving directions printed on your pack. Many people find it easiest to pair each sachet with a meal.</p>"
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "question": "What happens after 45 days?",
            "answer": "<p>You'll have completed one full journey. You can continue with a new kit to keep your routine going.</p>"
          }
        },
        "f5": {
          "type": "faq",
          "settings": {
            "question": "I missed a sachet. What should I do?",
            "answer": "<p>Simply continue with your next sachet. Don't double up — just pick up where you left off.</p>",
            "open_by_default": false
          }
        }
      },
